{
  "schema_version": "proposed-1",
  "status": "Illustrative planning contract, not a shipped configuration loader or an authorized paid run.",
  "notes": [
    "Roles below only demonstrate all three mandatory providers; the owner has not chosen role assignments.",
    "env: references and null required values must be resolved and capability-tested before admission. Secrets are references only.",
    "Unknown limits, prices and capabilities are not zero or permission to guess. Null optional settings are omitted, never sent as zero.",
    "The same model profile appears in two roles with distinct output budgets. Temperature, top-p and reasoning settings remain independently tunable when supported.",
    "An endpoint may be a provider endpoint or an authorized compatible gateway. Actual vendor, endpoint and effective model/settings must be recorded."
  ],
  "provider_endpoints": {
    "kimi_primary": {
      "vendor": "moonshot_kimi",
      "base_url_ref": "env:KIMI_BASE_URL",
      "api_dialect": "openai_chat_completions",
      "api_key_ref": "env:KIMI_API_KEY"
    },
    "glm_primary": {
      "vendor": "zai_glm",
      "base_url_ref": "env:GLM_BASE_URL",
      "api_dialect": "openai_chat_completions",
      "api_key_ref": "env:GLM_API_KEY"
    },
    "deepseek_primary": {
      "vendor": "deepseek",
      "base_url_ref": "env:DEEPSEEK_BASE_URL",
      "api_dialect": "openai_chat_completions",
      "api_key_ref": "env:DEEPSEEK_API_KEY"
    },
    "openai_optional": {
      "vendor": "openai",
      "enabled": false,
      "base_url_ref": "env:OPENAI_BASE_URL",
      "api_dialect": "openai_responses",
      "api_key_ref": "env:OPENAI_API_KEY"
    }
  },
  "model_profiles": {
    "kimi_selected": {
      "endpoint_ref": "kimi_primary",
      "exact_model_id_ref": "env:KIMI_MODEL_ID",
      "verified_capabilities_ref": null,
      "context_limit_tokens": null,
      "output_limit_tokens": null
    },
    "glm_selected": {
      "endpoint_ref": "glm_primary",
      "exact_model_id_ref": "env:GLM_MODEL_ID",
      "verified_capabilities_ref": null,
      "context_limit_tokens": null,
      "output_limit_tokens": null
    },
    "deepseek_selected": {
      "endpoint_ref": "deepseek_primary",
      "exact_model_id_ref": "env:DEEPSEEK_MODEL_ID",
      "verified_capabilities_ref": null,
      "context_limit_tokens": null,
      "output_limit_tokens": null
    }
  },
  "role_profiles": {
    "supervisor": {
      "model_profile": "kimi_selected",
      "prompt_template_ref": "prompts/supervisor.md",
      "tool_policy_ref": "policies/tools/supervisor.json",
      "requested_settings": {
        "temperature": null,
        "top_p": null,
        "reasoning_effort": null,
        "thinking_budget_tokens": null,
        "max_output_tokens": 8192
      },
      "max_tool_turns": 12,
      "context_policy_ref": "policies/context/supervisor.json",
      "per_call_timeouts": {
        "connect_seconds": 30,
        "read_seconds": 300
      },
      "retry_policy": {
        "max_attempts": 3,
        "backoff": "exponential_with_jitter",
        "ambiguous_outcome": "persist_before_retry"
      }
    },
