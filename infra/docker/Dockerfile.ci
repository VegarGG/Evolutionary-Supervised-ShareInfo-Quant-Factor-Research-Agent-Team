FROM ghcr.io/astral-sh/uv:0.11.19@sha256:b46b03ddfcfbf8f547af7e9eaefdf8a39c8cebcba7c98858d3162bd28cf536f6 AS uv
FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PATH=/workspace/.venv/bin:$PATH
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY packages ./packages
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --all-packages
COPY justfile .importlinter ./
COPY .github ./.github
COPY scripts ./scripts
COPY configs ./configs
COPY contracts ./contracts
COPY tests ./tests
COPY fixtures ./fixtures
COPY infra ./infra
# The locked environment was installed above. BuildKit's download cache is ephemeral;
# checks must use this environment without rebuilding editable packages at container start.
ENV UV_OFFLINE=1 UV_NO_SYNC=1
CMD ["bash", "infra/docker/ci-entrypoint.sh"]
