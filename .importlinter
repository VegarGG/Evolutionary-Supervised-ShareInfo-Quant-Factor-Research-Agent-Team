[importlinter]
root_packages =
    qfr_core
    qfr_registry
    qfr_research
    qfr_eval
    qfr_mcp

[importlinter:contract:research-eval]
name = Research never imports evaluation
type = forbidden
source_modules = qfr_research
forbidden_modules = qfr_eval

[importlinter:contract:eval-research]
name = Evaluation never imports research
type = forbidden
source_modules = qfr_eval
forbidden_modules = qfr_research

[importlinter:contract:registry]
name = Registry is independent of research and evaluation
type = forbidden
source_modules = qfr_registry
forbidden_modules =
    qfr_research
    qfr_eval

[importlinter:contract:core]
name = Core has no other qfr dependencies
type = forbidden
source_modules = qfr_core
forbidden_modules =
    qfr_registry
    qfr_research
    qfr_eval
    qfr_mcp

[importlinter:contract:mcp]
name = MCP uses only core and HTTP APIs
type = forbidden
source_modules = qfr_mcp
forbidden_modules =
    qfr_registry
    qfr_research
    qfr_eval
