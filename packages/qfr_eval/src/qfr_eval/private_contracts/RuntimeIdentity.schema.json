{
  "$defs": {
    "AccelerateImage": {
      "additionalProperties": false,
      "properties": {
        "cpu_subtype": {
          "title": "Cpu Subtype",
          "type": "integer"
        },
        "cpu_type": {
          "title": "Cpu Type",
          "type": "integer"
        },
        "image_uuid": {
          "format": "uuid",
          "title": "Image Uuid",
          "type": "string"
        },
        "install_name": {
          "minLength": 1,
          "title": "Install Name",
          "type": "string"
        },
        "text_bytes": {
          "exclusiveMinimum": 0,
          "title": "Text Bytes",
          "type": "integer"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        }
      },
      "required": [
        "install_name",
        "image_uuid",
        "cpu_type",
        "cpu_subtype",
        "text_bytes",
        "text_sha256"
      ],
      "title": "AccelerateImage",
      "type": "object"
    },
    "AppleAccelerateExecution": {
      "additionalProperties": false,
      "properties": {
        "consumers": {
          "additionalProperties": {
            "const": "accelerate",
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "numpy",
              "scipy"
            ]
          },
          "title": "Consumers",
          "type": "object"
        },
        "cpu_brand": {
          "minLength": 1,
          "title": "Cpu Brand",
          "type": "string"
        },
        "effective_threads": {
          "const": 1,
          "title": "Effective Threads",
          "type": "integer"
        },
        "extension_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Extension Hashes",
          "type": "object"
        },
        "hardware_model": {
          "minLength": 1,
          "title": "Hardware Model",
          "type": "string"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/AccelerateImage"
          },
          "title": "Images",
          "type": "array"
        },
        "os_build": {
          "minLength": 1,
          "title": "Os Build",
          "type": "string"
        },
        "os_version": {
          "minLength": 1,
          "title": "Os Version",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "threading_mode": {
          "const": "single_threaded",
          "title": "Threading Mode",
          "type": "string"
        },
        "threading_scope": {
          "const": "calling_thread",
          "title": "Threading Scope",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "policy_sha256",
        "threading_mode",
        "threading_scope",
        "effective_threads",
        "os_version",
        "os_build",
        "hardware_model",
        "cpu_brand",
        "consumers",
        "extension_hashes",
        "images"
      ],
      "title": "AppleAccelerateExecution",
      "type": "object"
    },
    "NumericalExecution": {
      "additionalProperties": false,
      "properties": {
        "accelerate": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppleAccelerateExecution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "libraries": {
          "items": {
            "$ref": "#/$defs/NumericalLibrary"
          },
          "title": "Libraries",
          "type": "array"
        },
        "machine": {
          "minLength": 1,
          "title": "Machine",
          "type": "string"
        },
        "polars_threads": {
          "exclusiveMinimum": 0,
          "title": "Polars Threads",
          "type": "integer"
        },
        "schema_version": {
          "enum": [
            "1",
            "2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "thread_environment": {
          "additionalProperties": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Thread Environment",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "system",
        "machine",
        "polars_threads",
        "thread_environment",
        "libraries"
      ],
      "title": "NumericalExecution",
      "type": "object"
    },
    "NumericalLibrary": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Architecture"
        },
        "binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binary Sha256",
          "type": "string"
        },
        "internal_api": {
          "enum": [
            "openblas",
            "mkl",
            "blis",
            "openmp"
          ],
          "title": "Internal Api",
          "type": "string"
        },
        "num_threads": {
          "exclusiveMinimum": 0,
          "title": "Num Threads",
          "type": "integer"
        },
        "prefix": {
          "minLength": 1,
          "title": "Prefix",
          "type": "string"
        },
        "threading_layer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threading Layer"
        },
        "user_api": {
          "enum": [
            "blas",
            "openmp"
          ],
          "title": "User Api",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "user_api",
        "internal_api",
        "prefix",
        "version",
        "num_threads",
        "architecture",
        "threading_layer",
        "binary_sha256"
      ],
      "title": "NumericalLibrary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluator_git_sha": {
      "minLength": 1,
      "title": "Evaluator Git Sha",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "numerical_execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/NumericalExecution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1",
      "enum": [
        "1",
        "2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "software": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Software",
      "type": "object"
    }
  },
  "required": [
    "evaluator_git_sha",
    "implementation_sha256",
    "image_digest",
    "software"
  ],
  "title": "RuntimeIdentity",
  "type": "object"
}
