{
  "$defs": {
    "NumericalExecution": {
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "items": {
            "$ref": "#/$defs/NumericalLibrary"
          },
          "title": "Libraries",
          "type": "array"
        },
        "machine": {
          "minLength": 1,
          "title": "Machine",
          "type": "string"
        },
        "polars_threads": {
          "exclusiveMinimum": 0,
          "title": "Polars Threads",
          "type": "integer"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "thread_environment": {
          "additionalProperties": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Thread Environment",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "system",
        "machine",
        "polars_threads",
        "thread_environment",
        "libraries"
      ],
      "title": "NumericalExecution",
      "type": "object"
    },
    "NumericalLibrary": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Architecture"
        },
        "binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binary Sha256",
          "type": "string"
        },
        "internal_api": {
          "enum": [
            "openblas",
            "mkl",
            "blis",
            "openmp"
          ],
          "title": "Internal Api",
          "type": "string"
        },
        "num_threads": {
          "exclusiveMinimum": 0,
          "title": "Num Threads",
          "type": "integer"
        },
        "prefix": {
          "minLength": 1,
          "title": "Prefix",
          "type": "string"
        },
        "threading_layer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threading Layer"
        },
        "user_api": {
          "enum": [
            "blas",
            "openmp"
          ],
          "title": "User Api",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "user_api",
        "internal_api",
        "prefix",
        "version",
        "num_threads",
        "architecture",
        "threading_layer",
        "binary_sha256"
      ],
      "title": "NumericalLibrary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluator_git_sha": {
      "minLength": 1,
      "title": "Evaluator Git Sha",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "numerical_execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/NumericalExecution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "1",
      "enum": [
        "1",
        "2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "software": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Software",
      "type": "object"
    }
  },
  "required": [
    "evaluator_git_sha",
    "implementation_sha256",
    "image_digest",
    "software"
  ],
  "title": "RuntimeIdentity",
  "type": "object"
}
