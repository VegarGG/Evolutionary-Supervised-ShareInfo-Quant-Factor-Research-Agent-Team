{
  "$defs": {
    "EvidenceIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_version_id": {
          "minLength": 1,
          "title": "Dataset Version Id",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash",
        "protocol_version",
        "dataset_version_id",
        "evaluator_version"
      ],
      "title": "EvidenceIdentity",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "enum": [
                "not_applicable",
                "insufficient_data",
                "withheld",
                "failed",
                "not_measured"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "missing_reason"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "SCHEMA_INVALID",
        "KIND_UNSUPPORTED",
        "PARSE_ERROR",
        "TYPE_ERROR",
        "COMPLEXITY_LIMIT",
        "FORBIDDEN_CONSTRUCT",
        "DECLARATION_MISMATCH",
        "DUPLICATE_OF",
        "NEAR_DUPLICATE_OF",
        "QUOTA_DEFERRED",
        "QUOTA_EXPIRED",
        "LOW_COVERAGE",
        "LOOKAHEAD_DETECTED",
        "RUNTIME_LIMIT",
        "DEGENERATE",
        "INTERNAL_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "cycle": {
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "fixed_quarter"
      ],
      "title": "Cycle",
      "type": "string"
    },
    "epoch_id": {
      "minLength": 1,
      "title": "Epoch Id",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/EvidenceIdentity"
    },
    "image_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/MetricValue"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Metrics",
      "type": "object"
    },
    "protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Hash",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "results_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Results Hash",
      "type": "string"
    },
    "run_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "sampling_unit": {
      "const": "mature_matched_decision",
      "title": "Sampling Unit",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "series_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Series Refs",
      "type": "array"
    },
    "stage": {
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "withheld"
      ],
      "title": "Status",
      "type": "string"
    },
    "window": {
      "minLength": 1,
      "title": "Window",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "identity",
    "epoch_id",
    "window",
    "stage",
    "run_ids",
    "image_digest",
    "protocol_hash",
    "request_hash",
    "sampling_unit",
    "cycle",
    "seed",
    "status",
    "metrics",
    "series_refs",
    "results_hash",
    "reason_codes",
    "created_by",
    "request_id",
    "created_at"
  ],
  "title": "OfficialRecord",
  "type": "object"
}
