{
  "$defs": {
    "NumericalExecution": {
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "items": {
            "$ref": "#/$defs/NumericalLibrary"
          },
          "title": "Libraries",
          "type": "array"
        },
        "machine": {
          "minLength": 1,
          "title": "Machine",
          "type": "string"
        },
        "polars_threads": {
          "exclusiveMinimum": 0,
          "title": "Polars Threads",
          "type": "integer"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "system": {
          "minLength": 1,
          "title": "System",
          "type": "string"
        },
        "thread_environment": {
          "additionalProperties": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Thread Environment",
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "system",
        "machine",
        "polars_threads",
        "thread_environment",
        "libraries"
      ],
      "title": "NumericalExecution",
      "type": "object"
    },
    "NumericalLibrary": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Architecture"
        },
        "binary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Binary Sha256",
          "type": "string"
        },
        "internal_api": {
          "enum": [
            "openblas",
            "mkl",
            "blis",
            "openmp"
          ],
          "title": "Internal Api",
          "type": "string"
        },
        "num_threads": {
          "exclusiveMinimum": 0,
          "title": "Num Threads",
          "type": "integer"
        },
        "prefix": {
          "minLength": 1,
          "title": "Prefix",
          "type": "string"
        },
        "threading_layer": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threading Layer"
        },
        "user_api": {
          "enum": [
            "blas",
            "openmp"
          ],
          "title": "User Api",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "user_api",
        "internal_api",
        "prefix",
        "version",
        "num_threads",
        "architecture",
        "threading_layer",
        "binary_sha256"
      ],
      "title": "NumericalLibrary",
      "type": "object"
    },
    "RegistryExecutionBinding": {
      "additionalProperties": false,
      "properties": {
        "execution_bundle": {
          "$ref": "#/$defs/StoredFile"
        },
        "screening_receipt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Screening Receipt Hash",
          "type": "string"
        },
        "screening_record_id": {
          "format": "uuid",
          "title": "Screening Record Id",
          "type": "string"
        }
      },
      "required": [
        "screening_record_id",
        "screening_receipt_hash",
        "execution_bundle"
      ],
      "title": "RegistryExecutionBinding",
      "type": "object"
    },
    "RuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "evaluator_git_sha": {
          "minLength": 1,
          "title": "Evaluator Git Sha",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "implementation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Sha256",
          "type": "string"
        },
        "numerical_execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericalExecution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "default": "1",
          "enum": [
            "1",
            "2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "software": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Software",
          "type": "object"
        }
      },
      "required": [
        "evaluator_git_sha",
        "implementation_sha256",
        "image_digest",
        "software"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    },
    "StoredFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "logical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Logical Sha256"
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/vnd.apache.parquet",
            "text/markdown"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "relative_path",
        "media_type",
        "logical_sha256"
      ],
      "title": "StoredFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_version_id": {
      "format": "uuid",
      "title": "Artifact Version Id",
      "type": "string"
    },
    "cohort_id": {
      "minLength": 1,
      "title": "Cohort Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "cycle": {
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "fixed_quarter"
      ],
      "title": "Cycle",
      "type": "string"
    },
    "economic_lineage_id": {
      "minLength": 1,
      "title": "Economic Lineage Id",
      "type": "string"
    },
    "epoch_id": {
      "minLength": 1,
      "title": "Epoch Id",
      "type": "string"
    },
    "family_id": {
      "minLength": 1,
      "title": "Family Id",
      "type": "string"
    },
    "generation_id": {
      "minLength": 1,
      "title": "Generation Id",
      "type": "string"
    },
    "intent": {
      "enum": [
        "evaluated",
        "withheld",
        "diagnostic"
      ],
      "title": "Intent",
      "type": "string"
    },
    "program_id": {
      "minLength": 1,
      "title": "Program Id",
      "type": "string"
    },
    "protocol_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Protocol Hash",
      "type": "string"
    },
    "protocol_id": {
      "minLength": 1,
      "title": "Protocol Id",
      "type": "string"
    },
    "protocol_version": {
      "minLength": 1,
      "title": "Protocol Version",
      "type": "string"
    },
    "registry_execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegistryExecutionBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeIdentity"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "variant": {
      "enum": [
        "registry",
        "baseline",
        "P1_reversal_momentum",
        "N1_reversal_weight040",
        "N2_reversal_weight060",
        "N3_reversal_lag_short",
        "N4_reversal_lag_long",
        "N5_momentum_lookback100",
        "N6_momentum_lookback140"
      ],
      "title": "Variant",
      "type": "string"
    },
    "window": {
      "enum": [
        "development",
        "validation"
      ],
      "title": "Window",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "variant",
    "artifact_version_id",
    "content_hash",
    "protocol_id",
    "protocol_version",
    "protocol_hash",
    "snapshot_id",
    "epoch_id",
    "window",
    "cycle",
    "program_id",
    "family_id",
    "economic_lineage_id",
    "generation_id",
    "cohort_id",
    "intent",
    "runtime"
  ],
  "title": "EvaluationRequest",
  "type": "object"
}
