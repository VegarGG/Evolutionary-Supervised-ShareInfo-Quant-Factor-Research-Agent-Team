    },
    "clusters_match": {
      "title": "Clusters Match",
      "type": "boolean"
    },
    "expected_results_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Results Hash",
      "type": "string"
    },
    "fingerprint_match": {
      "title": "Fingerprint Match",
      "type": "boolean"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "series_match": {
      "title": "Series Match",
      "type": "boolean"
    },
    "status": {
