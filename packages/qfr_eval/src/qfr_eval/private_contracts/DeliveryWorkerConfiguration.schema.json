{
  "$defs": {
    "PilotDeliveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "checker_id": {
          "enum": [
            "pilot-research-delivery-v1",
            "pilot-research-delivery-v2"
          ],
          "title": "Checker Id",
          "type": "string"
        },
        "maximum_artifacts": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Maximum Artifacts",
          "type": "integer"
        },
        "maximum_payload_bytes": {
          "exclusiveMinimum": 0,
          "title": "Maximum Payload Bytes",
          "type": "integer"
        },
        "maximum_reports": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Maximum Reports",
          "type": "integer"
        },
        "negative_meaning": {
          "const": "declared_scope_does_not_meet_frozen_research_hurdle",
          "title": "Negative Meaning",
          "type": "string"
        },
        "release_policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Policy Sha256",
          "type": "string"
        },
        "reproduction": {
          "const": "immutable_evaluator_exact_match_event",
          "title": "Reproduction",
          "type": "string"
        },
        "required_execution": {
          "const": "registry",
          "title": "Required Execution",
          "type": "string"
        },
        "schema_version": {
          "enum": [
            "1",
            "2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "const": "P0_P1_verification_only",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "checker_id",
        "scope",
        "release_policy_sha256",
        "required_execution",
        "reproduction",
        "negative_meaning",
        "maximum_artifacts",
        "maximum_reports",
        "maximum_payload_bytes"
      ],
      "title": "PilotDeliveryPolicy",
      "type": "object"
    },
    "PublicServiceClientConfiguration": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "max_request_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_response_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "token_ref": {
          "pattern": "^env:[A-Z][A-Z0-9_]*$",
          "title": "Token Ref",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "base_url",
        "token_ref",
        "timeout_seconds",
        "max_request_bytes",
        "max_response_bytes"
      ],
      "title": "PublicServiceClientConfiguration",
      "type": "object"
    },
    "RegistryClientConfiguration": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "max_request_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_response_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "token_ref": {
          "pattern": "^env:[A-Z][A-Z0-9_]*$",
          "title": "Token Ref",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "base_url",
        "token_ref",
        "timeout_seconds",
        "max_request_bytes",
        "max_response_bytes"
      ],
      "title": "RegistryClientConfiguration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/PilotDeliveryPolicy"
    },
    "program_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
      "title": "Program Id",
      "type": "string"
    },
    "registry_client": {
      "$ref": "#/$defs/RegistryClientConfiguration"
    },
    "research_client": {
      "$ref": "#/$defs/PublicServiceClientConfiguration"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "program_id",
    "research_client",
    "registry_client",
    "policy"
  ],
  "title": "DeliveryWorkerConfiguration",
  "type": "object"
}
