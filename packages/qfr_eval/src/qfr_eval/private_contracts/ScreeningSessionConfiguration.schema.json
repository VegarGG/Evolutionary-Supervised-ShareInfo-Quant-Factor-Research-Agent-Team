          "type": "integer"
        },
        "strategy_cost_policy_ref": {
          "minLength": 1,
          "title": "Strategy Cost Policy Ref",
          "type": "string"
        },
        "strategy_execution": {
          "const": "next_close",
          "title": "Strategy Execution",
          "type": "string"
