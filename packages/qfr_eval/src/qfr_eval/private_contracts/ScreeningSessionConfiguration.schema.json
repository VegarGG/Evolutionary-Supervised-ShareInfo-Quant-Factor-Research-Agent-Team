        "duplicates",
        "required_eligible_coverage",
        "reject_constant_scorer_fraction",
        "fixed_position_strategy_exempt",
        "score_atol",
        "score_rtol",
        "preserve_original_eligibility_and_warmup",
        "feedback_versions_per_lineage_generation"
