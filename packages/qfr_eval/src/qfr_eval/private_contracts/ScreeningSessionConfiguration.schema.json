        "warmup": {
          "enum": [
            "original_pilot_eligibility",
            "declared_source_observations"
          ],
          "title": "Warmup",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "revision",
        "scope",
        "adapter",
        "warmup",
        "strategy_cost_bps",
        "strategy_execution",
        "strategy_cost_policy_ref",
        "data_product_check"
