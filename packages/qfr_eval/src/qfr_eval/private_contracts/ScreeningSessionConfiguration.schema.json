        "poll_interval_seconds",
        "deferral_expiry_seconds",
        "fairness",
        "idle_behavior"
      ],
      "title": "IntakePolicy",
      "type": "object"
    },
    "KindAdapterProfile": {
      "additionalProperties": false,
      "description": "Explicit supported output conventions, never stock admission thresholds.",
      "properties": {
        "adapter": {
          "enum": [
            "pilot_rotation_v1",
            "price_panel_v1"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "data_product_check": {
          "const": "identity-prices/1",
          "title": "Data Product Check",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "P0_P1_verification_only",
            "synthetic_contract_fixtures_only"
          ],
          "title": "Scope",
          "type": "string"
        },
        "strategy_cost_bps": {
          "minimum": 0,
