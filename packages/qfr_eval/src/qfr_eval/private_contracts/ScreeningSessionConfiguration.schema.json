        },
        "max_expression_length": {
          "exclusiveMinimum": 0,
          "title": "Max Expression Length",
          "type": "integer"
        },
        "max_fields": {
          "exclusiveMinimum": 0,
          "title": "Max Fields",
          "type": "integer"
        },
        "max_lookback": {
          "exclusiveMinimum": 0,
          "title": "Max Lookback",
