{
  "$defs": {
    "EvidenceIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_version_id": {
          "minLength": 1,
          "title": "Dataset Version Id",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash",
        "protocol_version",
        "dataset_version_id",
        "evaluator_version"
      ],
      "title": "EvidenceIdentity",
      "type": "object"
    },
    "StoredFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "logical_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Logical Sha256"
        },
        "media_type": {
          "enum": [
            "application/json",
            "application/vnd.apache.parquet",
            "text/markdown"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "relative_path",
        "media_type",
        "logical_sha256"
      ],
      "title": "StoredFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authenticity": {
      "const": "internal_unsigned",
      "title": "Authenticity",
      "type": "string"
    },
    "files": {
      "additionalProperties": {
        "$ref": "#/$defs/StoredFile"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Files",
      "type": "object"
    },
    "identity": {
      "$ref": "#/$defs/EvidenceIdentity"
    },
    "kind": {
      "const": "private_screening",
      "title": "Kind",
      "type": "string"
    },
    "receipt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Receipt Hash",
      "type": "string"
    },
    "record_id": {
      "format": "uuid",
      "title": "Record Id",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "results_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Results Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "trial_id": {
      "format": "uuid",
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "authenticity",
    "record_id",
    "trial_id",
    "identity",
    "request_hash",
    "results_hash",
    "files",
    "receipt_hash"
  ],
  "title": "ScreeningReceipt",
  "type": "object"
}
