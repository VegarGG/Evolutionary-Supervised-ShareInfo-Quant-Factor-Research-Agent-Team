{
  "$defs": {
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "enum": [
                "not_applicable",
                "insufficient_data",
                "withheld",
                "failed",
                "not_measured"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "missing_reason"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "ReleasedScalar": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "enum": [
            "current_version",
            "lineage_best"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "baseline_version_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Version Id"
        },
        "cost_basis_ref": {
          "minLength": 1,
          "title": "Cost Basis Ref",
          "type": "string"
        },
        "measurement": {
          "$ref": "#/$defs/MetricValue"
        },
        "metric": {
          "enum": [
            "extreme_macro_recall",
            "RankIC_mean"
          ],
          "title": "Metric",
          "type": "string"
        },
        "origin_artifact_version_id": {
          "minLength": 1,
          "title": "Origin Artifact Version Id",
          "type": "string"
        },
        "period_count": {
          "minimum": 0,
          "title": "Period Count",
          "type": "integer"
        },
        "sampling_unit": {
          "enum": [
            "mature_matched_decision",
            "trading_date"
          ],
          "title": "Sampling Unit",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "sampling_unit",
        "period_count",
        "cost_basis_ref",
        "baseline_version_id",
        "measurement",
        "origin_artifact_version_id",
        "attribution"
      ],
      "title": "ReleasedScalar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scalar": {
      "$ref": "#/$defs/ReleasedScalar"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "unrounded_score": {
      "title": "Unrounded Score",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "scope_sha256",
    "unrounded_score",
    "scalar"
  ],
  "title": "LadderBest",
  "type": "object"
}
