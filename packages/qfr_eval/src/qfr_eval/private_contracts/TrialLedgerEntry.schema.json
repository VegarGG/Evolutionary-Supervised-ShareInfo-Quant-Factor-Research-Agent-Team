{
  "$defs": {
    "EvidenceIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "dataset_version_id": {
          "minLength": 1,
          "title": "Dataset Version Id",
          "type": "string"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "protocol_version": {
          "minLength": 1,
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash",
        "protocol_version",
        "dataset_version_id",
        "evaluator_version"
      ],
      "title": "EvidenceIdentity",
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "enum": [
                "not_applicable",
                "insufficient_data",
                "withheld",
                "failed",
                "not_measured"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "missing_reason"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "TrialObservation": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "cohort_id": {
          "minLength": 1,
          "title": "Cohort Id",
          "type": "string"
        },
        "economic_lineage_id": {
          "minLength": 1,
          "title": "Economic Lineage Id",
          "type": "string"
        },
        "family_id": {
          "minLength": 1,
          "title": "Family Id",
          "type": "string"
        },
        "generation_id": {
          "minLength": 1,
          "title": "Generation Id",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "program_id": {
          "minLength": 1,
          "title": "Program Id",
          "type": "string"
        },
        "protocol_hash": {
          "minLength": 1,
          "title": "Protocol Hash",
          "type": "string"
        },
        "returns": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Returns",
          "type": "array"
        },
        "sampling_unit": {
          "enum": [
            "trading_date",
            "mature_matched_decision"
          ],
          "title": "Sampling Unit",
          "type": "string"
        },
        "selectable": {
          "title": "Selectable",
          "type": "boolean"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "evaluated",
            "failed",
            "withheld",
            "diagnostic"
          ],
          "title": "Status",
          "type": "string"
        },
        "trial_id": {
          "minLength": 1,
          "title": "Trial Id",
          "type": "string"
        },
        "window": {
          "minLength": 1,
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "trial_id",
        "artifact_version_id",
        "family_id",
        "economic_lineage_id",
        "generation_id",
        "program_id",
        "protocol_hash",
        "snapshot_id",
        "window",
        "cohort_id",
        "status",
        "selectable",
        "sampling_unit",
        "returns",
        "observation_ids"
      ],
      "title": "TrialObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "counted_at": {
      "format": "date-time",
      "title": "Counted At",
      "type": "string"
    },
    "epoch_id": {
      "minLength": 1,
      "title": "Epoch Id",
      "type": "string"
    },
    "family_id": {
      "minLength": 1,
      "title": "Family Id",
      "type": "string"
    },
    "fingerprint_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Fingerprint Ref"
    },
    "identity": {
      "$ref": "#/$defs/EvidenceIdentity"
    },
    "kurt_raw": {
      "$ref": "#/$defs/MetricValue"
    },
    "n_obs": {
      "minimum": 0,
      "title": "N Obs",
      "type": "integer"
    },
    "observation": {
      "$ref": "#/$defs/TrialObservation"
    },
    "official_record_id": {
      "minLength": 1,
      "title": "Official Record Id",
      "type": "string"
    },
    "program_id": {
      "minLength": 1,
      "title": "Program Id",
      "type": "string"
    },
    "sampling_unit": {
      "const": "mature_matched_decision",
      "title": "Sampling Unit",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "selectable": {
      "title": "Selectable",
      "type": "boolean"
    },
    "sharpe_per_period": {
      "$ref": "#/$defs/MetricValue"
    },
    "skew": {
      "$ref": "#/$defs/MetricValue"
    },
    "status": {
      "enum": [
        "attempted",
        "evaluated",
        "failed",
        "withheld",
        "diagnostic"
      ],
      "title": "Status",
      "type": "string"
    },
    "trial_id": {
      "minLength": 1,
      "title": "Trial Id",
      "type": "string"
    },
    "window": {
      "minLength": 1,
      "title": "Window",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "trial_id",
    "official_record_id",
    "identity",
    "window",
    "epoch_id",
    "family_id",
    "program_id",
    "status",
    "selectable",
    "sampling_unit",
    "sharpe_per_period",
    "n_obs",
    "skew",
    "kurt_raw",
    "fingerprint_ref",
    "observation",
    "counted_at"
  ],
  "title": "TrialLedgerEntry",
  "type": "object"
}
