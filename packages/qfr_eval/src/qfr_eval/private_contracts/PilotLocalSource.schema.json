            "type": "string"
          },
          "title": "Fundamental Availability",
          "type": "object"
        },
        "industry_count": {
          "exclusiveMinimum": 0,
          "title": "Industry Count",
          "type": "integer"
        },
        "membership_note": {
          "title": "Membership Note",
          "type": "string"
        },
        "new_supplier_requests": {
