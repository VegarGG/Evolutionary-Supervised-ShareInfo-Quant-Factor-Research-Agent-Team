          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "scores_and_ranks": {
          "const": "exact",
          "title": "Scores And Ranks",
          "type": "string"
        },
        "vintage_note": {
          "title": "Vintage Note",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "profile",
        "industry_count",
        "benchmarks",
        "fundamental_availability",
        "price_overlap_atol",
        "price_overlap_rtol",
        "feature_parity_atol",
        "feature_parity_rtol",
        "scores_and_ranks",
        "exposure",
        "vintage_note",
        "membership_note",
        "new_supplier_requests"
