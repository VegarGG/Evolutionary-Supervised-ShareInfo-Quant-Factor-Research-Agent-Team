{
  "$defs": {
    "DockerNativeProfile": {
      "additionalProperties": false,
      "description": "New shared-kernel contract. Never reinterpret a historical runsc profile.",
      "properties": {
        "approval_ref": {
          "const": "owner-approved-2026-10-28-docker-native-v1",
          "title": "Approval Ref",
          "type": "string"
        },
        "boundary": {
          "const": "docker_shared_kernel",
          "title": "Boundary",
          "type": "string"
        },
        "control_timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Control Timeout Seconds",
          "type": "integer"
        },
        "cpu_seconds": {
          "exclusiveMinimum": 0,
          "title": "Cpu Seconds",
          "type": "integer"
        },
        "cpus": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Cpus",
          "type": "number"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "file_descriptors": {
          "exclusiveMinimum": 0,
          "title": "File Descriptors",
          "type": "integer"
        },
        "input_tmpfs_bytes": {
          "exclusiveMinimum": 0,
          "title": "Input Tmpfs Bytes",
          "type": "integer"
        },
        "max_input_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Input Bytes",
          "type": "integer"
        },
        "max_output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "max_package_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Package Bytes",
          "type": "integer"
        },
        "max_package_files": {
          "exclusiveMinimum": 0,
          "title": "Max Package Files",
          "type": "integer"
        },
        "memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "pids_limit": {
          "exclusiveMinimum": 0,
          "maximum": 16,
          "minimum": 4,
          "title": "Pids Limit",
          "type": "integer"
        },
        "process_accounting": {
          "const": "cgroup_total_tasks",
          "title": "Process Accounting",
          "type": "string"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "runtime": {
          "const": "runc",
          "title": "Runtime",
          "type": "string"
        },
        "schema_version": {
          "const": "2",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "P0_P1_verification_only",
            "bounded_synthetic_acceptance"
          ],
          "title": "Scope",
          "type": "string"
        },
        "seccomp_sha256": {
          "const": "514c38e72edc5363e87287ea87212211172c6c3251a974ca21ebfd05a56c7f5d",
          "title": "Seccomp Sha256",
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "tmpfs_bytes": {
          "exclusiveMinimum": 0,
          "title": "Tmpfs Bytes",
          "type": "integer"
        },
        "user_id": {
          "exclusiveMinimum": 0,
          "title": "User Id",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "revision",
        "scope",
        "runtime",
        "boundary",
        "approval_ref",
        "user_id",
        "cpus",
        "memory_bytes",
        "pids_limit",
        "process_accounting",
        "cpu_seconds",
        "timeout_seconds",
        "tmpfs_bytes",
        "input_tmpfs_bytes",
        "max_input_bytes",
        "max_package_bytes",
        "max_package_files",
        "max_output_bytes",
        "control_timeout_seconds",
        "file_descriptors",
        "dependency_lock_sha256",
        "seccomp_sha256"
      ],
      "title": "DockerNativeProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "control_socket": {
      "minLength": 1,
      "title": "Control Socket",
      "type": "string"
    },
    "docker_socket": {
      "minLength": 1,
      "title": "Docker Socket",
      "type": "string"
    },
    "image_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "max_parallel_jobs": {
      "const": 1,
      "title": "Max Parallel Jobs",
      "type": "integer"
    },
    "profile": {
      "$ref": "#/$defs/DockerNativeProfile"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "profile",
    "image_digest",
    "docker_socket",
    "control_socket",
    "max_parallel_jobs"
  ],
  "title": "DockerControllerConfiguration",
  "type": "object"
}
