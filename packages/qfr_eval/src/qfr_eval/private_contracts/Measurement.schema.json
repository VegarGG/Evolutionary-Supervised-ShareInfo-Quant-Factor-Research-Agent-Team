        "block_length": {
          "minimum": 0,
          "title": "Block Length",
          "type": "integer"
        },
        "ci_lower": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Ci Lower",
          "type": "array"
        },
        "ci_upper": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Ci Upper",
          "type": "array"
        },
        "draws": {
          "minimum": 0,
          "title": "Draws",
          "type": "integer"
        },
        "index_sha256": {
