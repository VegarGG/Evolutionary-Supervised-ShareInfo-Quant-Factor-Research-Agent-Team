        "means": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Means",
          "type": "array"
        },
        "method": {
          "const": "romano_wolf_stepdown_studentized_maxT",
          "title": "Method",
          "type": "string"
