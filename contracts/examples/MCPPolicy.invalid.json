{
  "allowed_hosts": [
    "127.0.0.1:*",
    "localhost:*",
    "mcp-api:8000"
  ],
  "allowed_origins": [
    "http://127.0.0.1:*",
    "http://localhost:*"
  ],
  "default_page_size": 20,
  "dns_rebinding_protection": true,
  "max_inline_result_bytes": 32768,
