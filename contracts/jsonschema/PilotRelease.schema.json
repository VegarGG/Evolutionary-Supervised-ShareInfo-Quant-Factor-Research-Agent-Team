{
  "$defs": {
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "enum": [
                "not_applicable",
                "insufficient_data",
                "withheld",
                "failed",
                "not_measured"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "missing_reason"
      ],
      "title": "MetricValue",
      "type": "object"
    },
    "PilotHurdleFlags": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "fold_majority": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Fold Majority",
          "type": "string"
        },
        "incremental_contribution": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Incremental Contribution",
          "type": "string"
        },
        "net_result": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Net Result",
          "type": "string"
        },
        "novelty": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Novelty",
          "type": "string"
        },
        "overall": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Overall",
          "type": "string"
        },
        "paired_primary": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Paired Primary",
          "type": "string"
        },
        "placebo": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Placebo",
          "type": "string"
        },
        "turnover": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Turnover",
          "type": "string"
        },
        "uncertainty_stability": {
          "enum": [
            "pass",
            "fail",
            "insufficient_data",
            "not_applicable"
          ],
          "title": "Uncertainty Stability",
          "type": "string"
        }
      },
      "required": [
        "paired_primary",
        "incremental_contribution",
        "fold_majority",
        "placebo",
        "net_result",
        "turnover",
        "novelty",
        "uncertainty_stability",
        "coverage",
        "overall"
      ],
      "title": "PilotHurdleFlags",
      "type": "object"
    },
    "ReleasedScalar": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "enum": [
            "current_version",
            "lineage_best"
          ],
          "title": "Attribution",
          "type": "string"
        },
        "baseline_version_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Version Id"
        },
        "cost_basis_ref": {
          "minLength": 1,
          "title": "Cost Basis Ref",
          "type": "string"
        },
        "measurement": {
          "$ref": "#/$defs/MetricValue"
        },
        "metric": {
          "enum": [
            "extreme_macro_recall",
            "RankIC_mean"
          ],
          "title": "Metric",
          "type": "string"
        },
        "origin_artifact_version_id": {
          "minLength": 1,
          "title": "Origin Artifact Version Id",
          "type": "string"
        },
        "period_count": {
          "minimum": 0,
          "title": "Period Count",
          "type": "integer"
        },
        "sampling_unit": {
          "enum": [
            "mature_matched_decision",
            "trading_date"
          ],
          "title": "Sampling Unit",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "sampling_unit",
        "period_count",
        "cost_basis_ref",
        "baseline_version_id",
        "measurement",
        "origin_artifact_version_id",
        "attribution"
      ],
      "title": "ReleasedScalar",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hurdle_flags": {
      "$ref": "#/$defs/PilotHurdleFlags"
    },
    "minimum_detectable_effect": {
      "$ref": "#/$defs/MetricValue"
    },
    "not_for_selection": {
      "title": "Not For Selection",
      "type": "boolean"
    },
    "quality_flags": {
      "items": {
        "enum": [
          "small_sample_warning",
          "pit_grade_downgrade",
          "duplicate"
        ],
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "rank_bucket": {
      "enum": [
        "top",
        "middle",
        "bottom",
        "withheld"
      ],
      "title": "Rank Bucket",
      "type": "string"
    },
    "scalar": {
      "$ref": "#/$defs/ReleasedScalar"
    },
    "type": {
      "const": "pilot",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "scalar",
    "hurdle_flags",
    "rank_bucket",
    "quality_flags",
    "minimum_detectable_effect",
    "not_for_selection"
  ],
  "title": "PilotRelease",
  "type": "object"
}
