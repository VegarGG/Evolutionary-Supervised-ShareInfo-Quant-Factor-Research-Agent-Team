{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "CompositeComponent": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactReference"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "artifact",
        "weight"
      ],
      "title": "CompositeComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/CompositeComponent"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "fitting": {
      "const": false,
      "title": "Fitting",
      "type": "boolean"
    },
    "type": {
      "const": "fixed_composite",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "components",
    "fitting"
  ],
  "title": "CompositeImplementation",
  "type": "object"
}
