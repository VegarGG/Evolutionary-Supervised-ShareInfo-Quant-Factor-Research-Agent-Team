      "required": [
        "cpu_seconds",
        "memory_bytes",
        "timeout_seconds",
        "max_output_bytes",
        "network",
        "read_only_root",
        "non_root",
        "dropped_capabilities"
      ],
      "title": "ResourceLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "execution_contract": {
      "$ref": "#/$defs/ExecutionContract"
    },
    "package_asset_id": {
      "minLength": 1,
      "title": "Package Asset Id",
      "type": "string"
    },
    "type": {
      "const": "declared_package_runner",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "package_asset_id",
    "execution_contract"
  ],
  "title": "PackageImplementation",
  "type": "object"
}
