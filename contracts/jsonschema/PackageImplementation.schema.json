{
  "$defs": {
    "ExecutionContract": {
      "additionalProperties": false,
      "properties": {
        "approved_sandbox_profile_ref": {
          "minLength": 1,
          "title": "Approved Sandbox Profile Ref",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Command"
        },
        "dependency_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dependency Lock Sha256",
          "type": "string"
        },
        "function": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Function"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "input_schema_ref": {
          "minLength": 1,
          "title": "Input Schema Ref",
          "type": "string"
        },
        "interface": {
          "enum": [
            "command",
            "function"
          ],
          "title": "Interface",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/ResourceLimits"
        },
        "output_schema_ref": {
          "minLength": 1,
          "title": "Output Schema Ref",
          "type": "string"
        },
        "runner": {
          "minLength": 1,
          "title": "Runner",
          "type": "string"
        },
        "seeds": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Seeds",
          "type": "array"
        }
      },
      "required": [
        "runner",
        "image_digest",
        "dependency_lock_sha256",
        "interface",
        "command",
        "function",
        "input_schema_ref",
        "output_schema_ref",
        "seeds",
        "limits",
        "approved_sandbox_profile_ref"
      ],
      "title": "ExecutionContract",
      "type": "object"
    },
    "ResourceLimits": {
      "additionalProperties": false,
      "properties": {
        "cpu_seconds": {
          "exclusiveMinimum": 0,
          "title": "Cpu Seconds",
          "type": "integer"
        },
        "dropped_capabilities": {
          "const": "ALL",
          "title": "Dropped Capabilities",
          "type": "string"
        },
        "max_output_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Output Bytes",
          "type": "integer"
        },
        "memory_bytes": {
          "exclusiveMinimum": 0,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "network": {
          "const": "none",
          "title": "Network",
          "type": "string"
        },
        "non_root": {
          "const": true,
          "title": "Non Root",
          "type": "boolean"
        },
        "read_only_root": {
          "const": true,
          "title": "Read Only Root",
          "type": "boolean"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
