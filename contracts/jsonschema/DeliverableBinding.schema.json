{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A requested output names an immutable Registry artifact, not local bytes.",
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    }
  },
  "required": [
    "name",
    "artifact"
  ],
  "title": "DeliverableBinding",
  "type": "object"
}
