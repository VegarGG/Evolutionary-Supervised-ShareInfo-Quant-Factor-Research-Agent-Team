{
  "$defs": {
    "AssetReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "relative_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        },
        "transport": {
          "enum": [
            "finalized_upload",
            "mounted_import"
          ],
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "reference_id"
      ],
      "title": "AssetReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "bytes": {
      "minimum": 0,
      "title": "Bytes",
      "type": "integer"
    },
    "intended_use": {
      "enum": [
        "primary_data",
        "auxiliary_data",
        "code",
        "config",
        "documentation",
        "evidence",
        "operations_precedent"
      ],
      "title": "Intended Use",
      "type": "string"
    },
    "licence": {
      "minLength": 1,
      "title": "Licence",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "provenance": {
      "minLength": 1,
      "title": "Provenance",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/AssetReference"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "source_is_untrusted_data": {
      "const": true,
      "title": "Source Is Untrusted Data",
      "type": "boolean"
    }
  },
  "required": [
    "asset_id",
    "reference",
    "sha256",
    "bytes",
    "media_type",
    "provenance",
    "intended_use",
    "licence",
    "source_is_untrusted_data"
  ],
  "title": "SourceAsset",
  "type": "object"
}
