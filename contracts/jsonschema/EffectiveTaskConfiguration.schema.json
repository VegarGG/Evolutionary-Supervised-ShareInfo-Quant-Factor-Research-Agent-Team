{
  "$defs": {
    "PricingSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cached_input_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Per Million"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "input_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Per Million"
        },
        "output_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Per Million"
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Ref"
        }
      },
      "required": [
        "snapshot_ref",
        "currency",
        "input_per_million",
        "output_per_million",
        "cached_input_per_million"
      ],
      "title": "PricingSnapshot",
      "type": "object"
    },
    "RequestedSettings": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking_budget_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget Tokens"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "RequestedSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_reservation_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Budget Reservation Usd"
    },
    "capability_test_revision": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Capability Test Revision"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "effective_settings": {
      "$ref": "#/$defs/RequestedSettings"
    },
    "endpoint_id": {
      "minLength": 1,
      "title": "Endpoint Id",
      "type": "string"
    },
    "exact_model_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exact Model Id"
    },
    "override_sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Override Sources",
      "type": "array"
    },
    "pricing_snapshot": {
      "$ref": "#/$defs/PricingSnapshot"
    },
    "prompt_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Hash",
      "type": "string"
    },
    "provider_vendor": {
      "minLength": 1,
      "title": "Provider Vendor",
      "type": "string"
    },
    "requested_settings": {
      "$ref": "#/$defs/RequestedSettings"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "role_profile": {
      "minLength": 1,
      "title": "Role Profile",
      "type": "string"
    },
    "status": {
      "enum": [
        "unresolved",
        "frozen"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "status",
    "task_id",
    "revision",
    "provider_vendor",
    "endpoint_id",
    "exact_model_id",
    "role_profile",
    "requested_settings",
    "effective_settings",
    "override_sources",
    "capability_test_revision",
    "prompt_hash",
    "config_hash",
    "pricing_snapshot",
    "budget_reservation_usd"
  ],
  "title": "EffectiveTaskConfiguration",
  "type": "object"
}
