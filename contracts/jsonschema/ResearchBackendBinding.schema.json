          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "max_request_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_response_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Response Bytes",
          "type": "integer"
