{
  "$defs": {
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "EffectiveTaskConfiguration": {
      "additionalProperties": false,
      "properties": {
        "budget_reservation_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Budget Reservation Usd"
        },
        "capability_test_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Capability Test Revision"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "effective_settings": {
          "$ref": "#/$defs/RequestedSettings"
        },
        "endpoint_id": {
          "minLength": 1,
          "title": "Endpoint Id",
          "type": "string"
        },
        "exact_model_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exact Model Id"
        },
        "override_sources": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Override Sources",
          "type": "array"
        },
        "pricing_snapshot": {
          "$ref": "#/$defs/PricingSnapshot"
        },
        "prompt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "provider_vendor": {
          "minLength": 1,
          "title": "Provider Vendor",
          "type": "string"
        },
        "requested_settings": {
          "$ref": "#/$defs/RequestedSettings"
        },
        "revision": {
          "exclusiveMinimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "role_profile": {
          "minLength": 1,
          "title": "Role Profile",
          "type": "string"
        },
        "status": {
          "enum": [
            "unresolved",
            "frozen"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "task_id",
        "revision",
        "provider_vendor",
        "endpoint_id",
        "exact_model_id",
        "role_profile",
        "requested_settings",
        "effective_settings",
        "override_sources",
        "capability_test_revision",
        "prompt_hash",
        "config_hash",
        "pricing_snapshot",
        "budget_reservation_usd"
      ],
      "title": "EffectiveTaskConfiguration",
      "type": "object"
    },
    "ExposureAndQuality": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "enum": [
            "previously_seen",
            "unknown",
            "prospective"
          ],
          "title": "History",
          "type": "string"
        },
        "inspected_periods": {
          "items": {
            "$ref": "#/$defs/DateRange"
          },
          "title": "Inspected Periods",
          "type": "array"
        },
        "licence_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Licence Constraints",
          "type": "array"
        },
        "provider_knowledge_exposure": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Provider Knowledge Exposure",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityLabels"
        },
        "training_tuning_history": {
          "minLength": 1,
          "title": "Training Tuning History",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "history",
        "inspected_periods",
        "training_tuning_history",
        "provider_knowledge_exposure",
        "quality",
        "licence_constraints",
        "unknowns"
      ],
      "title": "ExposureAndQuality",
      "type": "object"
    },
    "PITGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "PITGrade",
      "type": "string"
    },
    "PricingSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cached_input_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Per Million"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "input_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Per Million"
        },
        "output_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Per Million"
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Ref"
        }
      },
      "required": [
        "snapshot_ref",
        "currency",
        "input_per_million",
        "output_per_million",
        "cached_input_per_million"
      ],
      "title": "PricingSnapshot",
      "type": "object"
    },
    "QualityLabels": {
      "additionalProperties": false,
      "properties": {
        "membership_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/PITGrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "membership_notes": {
          "minLength": 1,
          "title": "Membership Notes",
          "type": "string"
        },
        "membership_status": {
          "enum": [
            "point_in_time",
            "backfilled",
            "unknown",
            "not_applicable"
          ],
          "title": "Membership Status",
          "type": "string"
        },
        "timing_basis": {
          "minLength": 1,
          "title": "Timing Basis",
          "type": "string"
        },
        "timing_grade": {
          "$ref": "#/$defs/PITGrade"
        },
        "vintage_notes": {
          "minLength": 1,
          "title": "Vintage Notes",
          "type": "string"
        },
        "vintage_status": {
          "enum": [
            "verified",
            "unknown",
            "restated"
          ],
          "title": "Vintage Status",
          "type": "string"
        }
      },
      "required": [
        "timing_grade",
        "timing_basis",
        "vintage_status",
        "vintage_notes",
        "membership_grade",
        "membership_status",
        "membership_notes"
      ],
      "title": "QualityLabels",
      "type": "object"
    },
    "RequestedSettings": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking_budget_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget Tokens"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "RequestedSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_runs": {
      "items": {
        "$ref": "#/$defs/EffectiveTaskConfiguration"
      },
      "title": "Agent Runs",
      "type": "array"
    },
    "blackboard_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Blackboard Refs",
      "type": "array"
    },
    "dependency_lock_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dependency Lock Sha256"
    },
    "exposure": {
      "$ref": "#/$defs/ExposureAndQuality"
    },
    "generation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Generation Id"
    },
    "island_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Island Id"
    },
    "operator": {
      "enum": [
        "explore",
        "llm_mutation",
        "syntactic_mutation",
        "crossover",
        "repair",
        "human_seed",
        "import"
      ],
      "title": "Operator",
      "type": "string"
    },
    "program_id": {
      "minLength": 1,
      "title": "Program Id",
      "type": "string"
    },
    "qfr_core_version": {
      "minLength": 1,
      "title": "Qfr Core Version",
      "type": "string"
    },
    "research_snapshot_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Research Snapshot Id"
    },
    "source_asset_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Source Asset Ids",
      "type": "array"
    },
    "source_hashes": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Source Hashes",
      "type": "array"
    },
    "task_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Task Id"
    }
  },
  "required": [
    "program_id",
    "generation_id",
    "island_id",
    "task_id",
    "operator",
    "source_asset_ids",
    "source_hashes",
    "blackboard_refs",
    "agent_runs",
    "research_snapshot_id",
    "qfr_core_version",
    "exposure",
    "dependency_lock_sha256"
  ],
  "title": "Provenance",
  "type": "object"
}
