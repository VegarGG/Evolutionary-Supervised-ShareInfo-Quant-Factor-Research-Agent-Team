{
  "$defs": {
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_outcome": {
          "const": "persist_before_retry",
          "title": "Ambiguous Outcome",
          "type": "string"
        },
        "backoff": {
          "enum": [
            "exponential_with_jitter",
            "fixed",
            "none"
          ],
          "title": "Backoff",
          "type": "string"
        },
        "backoff_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backoff Seconds"
        },
        "max_attempts": {
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "max_attempts",
        "backoff",
        "ambiguous_outcome"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "Timeouts": {
      "additionalProperties": false,
      "properties": {
        "connect_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Seconds",
          "type": "number"
        },
        "idle_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Seconds"
        },
        "read_seconds": {
          "exclusiveMinimum": 0,
          "title": "Read Seconds",
          "type": "number"
        }
      },
      "required": [
        "connect_seconds",
        "read_seconds"
      ],
      "title": "Timeouts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_label": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account Label"
    },
    "api_dialect": {
      "enum": [
        "openai_chat_completions",
        "openai_responses"
      ],
      "title": "Api Dialect",
      "type": "string"
    },
    "api_key_ref": {
      "pattern": "^env:[A-Z][A-Z0-9_]*$",
      "title": "Api Key Ref",
      "type": "string"
    },
    "base_url_ref": {
      "pattern": "^env:[A-Z][A-Z0-9_]*$",
      "title": "Base Url Ref",
      "type": "string"
    },
    "concurrency": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Concurrency"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "region": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "requests_per_minute": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requests Per Minute"
    },
    "retry_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetryPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeouts": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timeouts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tokens_per_minute": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tokens Per Minute"
    },
    "vendor": {
      "minLength": 1,
      "title": "Vendor",
      "type": "string"
    }
  },
  "required": [
    "vendor",
    "base_url_ref",
    "api_dialect",
    "api_key_ref"
  ],
  "title": "ProviderEndpoint",
  "type": "object"
}
