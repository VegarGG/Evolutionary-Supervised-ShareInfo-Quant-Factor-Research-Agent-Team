{
  "$defs": {
    "PricingSnapshot": {
      "additionalProperties": false,
      "properties": {
        "cached_input_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cached Input Per Million"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "input_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Per Million"
        },
        "output_per_million": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Per Million"
        },
        "snapshot_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Snapshot Ref"
        }
      },
      "required": [
        "snapshot_ref",
        "currency",
        "input_per_million",
        "output_per_million",
        "cached_input_per_million"
      ],
      "title": "PricingSnapshot",
      "type": "object"
    },
    "RequestedSettings": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking_budget_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget Tokens"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "RequestedSettings",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_outcome": {
          "const": "persist_before_retry",
          "title": "Ambiguous Outcome",
          "type": "string"
        },
        "backoff": {
          "enum": [
            "exponential_with_jitter",
            "fixed",
            "none"
          ],
          "title": "Backoff",
          "type": "string"
        },
        "backoff_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backoff Seconds"
        },
        "max_attempts": {
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "max_attempts",
        "backoff",
        "ambiguous_outcome"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "Timeouts": {
      "additionalProperties": false,
      "properties": {
        "connect_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Seconds",
          "type": "number"
        },
        "idle_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Seconds"
        },
        "read_seconds": {
          "exclusiveMinimum": 0,
          "title": "Read Seconds",
          "type": "number"
        }
      },
      "required": [
        "connect_seconds",
        "read_seconds"
      ],
      "title": "Timeouts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_reservation_usd": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Reservation Usd"
    },
    "context_policy_ref": {
      "minLength": 1,
      "title": "Context Policy Ref",
      "type": "string"
    },
    "fallback_allowlist": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Fallback Allowlist",
      "type": "array"
    },
    "max_tool_turns": {
      "exclusiveMinimum": 0,
      "title": "Max Tool Turns",
      "type": "integer"
    },
    "model_profile": {
      "minLength": 1,
      "title": "Model Profile",
      "type": "string"
    },
    "per_call_timeouts": {
      "$ref": "#/$defs/Timeouts"
    },
    "pricing_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/PricingSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt_template_ref": {
      "minLength": 1,
      "title": "Prompt Template Ref",
      "type": "string"
    },
    "requested_settings": {
      "$ref": "#/$defs/RequestedSettings"
    },
    "retry_policy": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "tool_allowlist": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Tool Allowlist",
      "type": "array"
    },
    "tool_policy_ref": {
      "minLength": 1,
      "title": "Tool Policy Ref",
      "type": "string"
    }
  },
  "required": [
    "model_profile",
    "prompt_template_ref",
    "tool_policy_ref",
    "requested_settings",
    "max_tool_turns",
    "context_policy_ref",
    "per_call_timeouts",
    "retry_policy"
  ],
  "title": "RoleProfile",
  "type": "object"
}
