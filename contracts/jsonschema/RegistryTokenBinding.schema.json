{
  "additionalProperties": false,
  "properties": {
    "principal": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Principal",
      "type": "string"
    },
    "programs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Programs",
      "type": "array"
    },
    "roles": {
      "items": {
        "enum": [
          "publisher",
          "reader",
          "evaluator"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Roles",
      "type": "array"
    },
    "token_ref": {
      "pattern": "^env:[A-Z][A-Z0-9_]*$",
      "title": "Token Ref",
      "type": "string"
    }
  },
  "required": [
    "principal",
    "token_ref",
    "roles",
    "programs"
  ],
  "title": "RegistryTokenBinding",
  "type": "object"
}
