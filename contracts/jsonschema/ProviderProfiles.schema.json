  "additionalProperties": false,
  "properties": {
    "capability_preflight": {
      "$ref": "#/$defs/CapabilityPreflight"
    },
    "job_policy": {
      "$ref": "#/$defs/JobPolicy"
    },
    "model_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/ModelProfile"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Model Profiles",
      "type": "object"
    },
    "notes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "provider_endpoints": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderEndpoint"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Provider Endpoints",
      "type": "object"
    },
    "role_profiles": {
      "additionalProperties": {
        "$ref": "#/$defs/RoleProfile"
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Role Profiles",
      "type": "object"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "minLength": 1,
      "title": "Status",
      "type": "string"
    },
    "task_override_fields": {
      "items": {
        "enum": [
          "model_profile",
          "prompt_template_ref",
          "requested_settings",
          "max_tool_turns",
          "context_policy_ref",
          "per_call_timeouts",
          "retry_policy",
          "fallback_allowlist"
