  "required": [
    "schema_version",
    "status",
    "notes",
    "provider_endpoints",
    "model_profiles",
    "role_profiles",
    "task_override_fields",
    "capability_preflight",
    "job_policy"
  ],
  "title": "ProviderProfiles",
  "type": "object"
}
