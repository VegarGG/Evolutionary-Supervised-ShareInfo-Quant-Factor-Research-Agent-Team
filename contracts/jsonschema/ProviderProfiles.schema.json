        "type": "string"
      },
      "title": "Task Override Fields",
      "type": "array"
    },
    "task_overrides": {
      "items": {
        "$ref": "#/$defs/TaskOverride"
      },
      "title": "Task Overrides",
      "type": "array"
    }
