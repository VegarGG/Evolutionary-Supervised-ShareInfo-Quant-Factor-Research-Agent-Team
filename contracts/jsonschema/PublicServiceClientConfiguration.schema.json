      "type": "string"
    },
    "max_request_bytes": {
      "exclusiveMinimum": 0,
      "title": "Max Request Bytes",
      "type": "integer"
    },
    "max_response_bytes": {
      "exclusiveMinimum": 0,
      "title": "Max Response Bytes",
      "type": "integer"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "token_ref": {
      "pattern": "^env:[A-Z][A-Z0-9_]*$",
      "title": "Token Ref",
      "type": "string"
    }
