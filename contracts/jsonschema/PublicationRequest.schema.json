{
  "$defs": {
    "ArtifactDefinition": {
      "additionalProperties": false,
      "description": "Publication input without invented server identities or audit timestamps.",
      "properties": {
        "complexity": {
          "minimum": 0,
          "title": "Complexity",
          "type": "integer"
        },
        "cycles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Cycles",
          "type": "array"
        },
        "data_requirements": {
          "items": {
            "$ref": "#/$defs/DataRequirement"
          },
          "title": "Data Requirements",
          "type": "array"
        },
        "eligible_protocols": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Eligible Protocols",
          "type": "array"
        },
        "family_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family Id"
        },
        "implementation": {
          "discriminator": {
            "mapping": {
              "constrained_python": "#/$defs/PythonImplementation",
              "declared_package_runner": "#/$defs/PackageImplementation",
              "document": "#/$defs/DocumentImplementation",
              "dsl": "#/$defs/DSLImplementation",
              "fixed_composite": "#/$defs/CompositeImplementation"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DSLImplementation"
            },
            {
              "$ref": "#/$defs/PythonImplementation"
            },
            {
              "$ref": "#/$defs/CompositeImplementation"
            },
            {
              "$ref": "#/$defs/PackageImplementation"
            },
            {
              "$ref": "#/$defs/DocumentImplementation"
            }
          ],
          "title": "Implementation"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "output_schema_ref": {
          "minLength": 1,
          "title": "Output Schema Ref",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Parameters",
          "type": "object"
        },
        "parent_version_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Version Ids",
          "type": "array"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "data_product": "#/$defs/DataProductPayload",
              "factor": "#/$defs/FactorPayload",
              "model": "#/$defs/ModelPayload",
              "research_note": "#/$defs/ResearchNotePayload",
              "strategy": "#/$defs/StrategyPayload"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FactorPayload"
            },
            {
              "$ref": "#/$defs/ModelPayload"
            },
            {
              "$ref": "#/$defs/StrategyPayload"
            },
            {
              "$ref": "#/$defs/ResearchNotePayload"
            },
            {
              "$ref": "#/$defs/DataProductPayload"
            }
          ],
          "title": "Payload"
        },
        "payload_files": {
          "items": {
            "$ref": "#/$defs/PayloadFile"
          },
          "title": "Payload Files",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rationale": {
          "$ref": "#/$defs/Rationale"
        },
        "research_side_checks": {
          "$ref": "#/$defs/ResearchChecks"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "family_id",
        "parent_version_ids",
        "name",
        "title",
        "kind",
        "implementation",
        "payload",
        "payload_files",
        "parameters",
        "data_requirements",
        "eligible_protocols",
        "cycles",
        "output_schema_ref",
        "rationale",
        "complexity",
        "provenance",
        "research_side_checks"
      ],
      "title": "ArtifactDefinition",
      "type": "object"
    },
