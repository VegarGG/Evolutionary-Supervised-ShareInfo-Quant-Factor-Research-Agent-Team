{
  "$defs": {
    "Conclusion": {
      "enum": [
        "supported_positive",
        "supported_negative",
        "empty_shortlist",
        "data_blocked"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "DeliverableRequirement": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs_required": {
          "title": "Evidence Refs Required",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_ref",
        "required",
        "evidence_refs_required"
      ],
      "title": "DeliverableRequirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_conclusions": {
      "items": {
        "$ref": "#/$defs/Conclusion"
      },
      "minItems": 1,
      "title": "Allowed Conclusions",
      "type": "array"
    },
    "evidence_release_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Release Requirements",
      "type": "array"
    },
    "forward_evidence_required": {
      "title": "Forward Evidence Required",
      "type": "boolean"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "gate_id": {
      "minLength": 1,
      "title": "Gate Id",
      "type": "string"
    },
    "gate_type": {
      "enum": [
        "research_delivery",
        "investment_promotion"
      ],
      "title": "Gate Type",
      "type": "string"
    },
    "human_signoff_required": {
      "title": "Human Signoff Required",
      "type": "boolean"
    },
    "independent_checker_required": {
      "const": true,
      "title": "Independent Checker Required",
      "type": "boolean"
    },
    "protocol_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Protocol Refs",
      "type": "array"
    },
    "reproducibility_criteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reproducibility Criteria",
      "type": "array"
    },
    "required_checks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Checks",
      "type": "array"
    },
    "required_deliverables": {
      "items": {
        "$ref": "#/$defs/DeliverableRequirement"
      },
      "minItems": 1,
      "title": "Required Deliverables",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Spec Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "gate_id",
    "gate_type",
    "required_deliverables",
    "protocol_refs",
    "required_checks",
    "reproducibility_criteria",
    "evidence_release_requirements",
    "allowed_conclusions",
    "human_signoff_required",
    "forward_evidence_required",
    "independent_checker_required",
    "frozen_at",
    "spec_hash"
  ],
  "title": "ExitGateSpecification",
  "type": "object"
}
