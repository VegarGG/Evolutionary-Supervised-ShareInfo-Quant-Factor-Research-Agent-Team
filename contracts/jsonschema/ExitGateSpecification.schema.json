{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "Conclusion": {
      "enum": [
        "supported_positive",
        "supported_negative",
        "empty_shortlist",
        "data_blocked"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "DeliverableRequirement": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs_required": {
          "title": "Evidence Refs Required",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_ref",
        "required",
        "evidence_refs_required"
      ],
      "title": "DeliverableRequirement",
      "type": "object"
    },
    "PilotDeliveryAssessment": {
      "additionalProperties": false,
      "description": "Exact artifact roles frozen before the human-driven pilot job is admitted.",
      "properties": {
        "assessed_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "minItems": 1,
          "title": "Assessed Artifact Refs",
          "type": "array"
        },
        "reference_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Reference Artifact Refs",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "assessed_artifact_refs",
        "reference_artifact_refs"
      ],
      "title": "PilotDeliveryAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_conclusions": {
      "items": {
        "$ref": "#/$defs/Conclusion"
      },
      "minItems": 1,
      "title": "Allowed Conclusions",
      "type": "array"
    },
    "assessment_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/PilotDeliveryAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_release_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Release Requirements",
      "type": "array"
    },
    "forward_evidence_required": {
      "title": "Forward Evidence Required",
      "type": "boolean"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "gate_id": {
      "minLength": 1,
      "title": "Gate Id",
      "type": "string"
    },
    "gate_type": {
      "enum": [
        "research_delivery",
        "investment_promotion"
      ],
      "title": "Gate Type",
      "type": "string"
    },
    "human_signoff_required": {
      "title": "Human Signoff Required",
      "type": "boolean"
    },
    "independent_checker_required": {
      "const": true,
      "title": "Independent Checker Required",
      "type": "boolean"
    },
    "protocol_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Protocol Refs",
      "type": "array"
    },
    "reproducibility_criteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reproducibility Criteria",
      "type": "array"
    },
    "required_checks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Checks",
      "type": "array"
    },
    "required_deliverables": {
      "items": {
        "$ref": "#/$defs/DeliverableRequirement"
      },
      "minItems": 1,
      "title": "Required Deliverables",
      "type": "array"
    },
    "schema_version": {
      "enum": [
        "1",
        "2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "spec_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Spec Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "gate_id",
    "gate_type",
    "required_deliverables",
    "protocol_refs",
    "required_checks",
    "reproducibility_criteria",
    "evidence_release_requirements",
    "allowed_conclusions",
    "human_signoff_required",
    "forward_evidence_required",
    "independent_checker_required",
    "frozen_at",
    "spec_hash"
  ],
  "title": "ExitGateSpecification",
  "type": "object"
}
