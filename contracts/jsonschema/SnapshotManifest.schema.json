{
  "$defs": {
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "ExposureAndQuality": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "enum": [
            "previously_seen",
            "unknown",
            "prospective"
          ],
          "title": "History",
          "type": "string"
        },
        "inspected_periods": {
          "items": {
            "$ref": "#/$defs/DateRange"
          },
          "title": "Inspected Periods",
          "type": "array"
        },
        "licence_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Licence Constraints",
          "type": "array"
        },
        "provider_knowledge_exposure": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Provider Knowledge Exposure",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityLabels"
        },
        "training_tuning_history": {
          "minLength": 1,
          "title": "Training Tuning History",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "history",
        "inspected_periods",
        "training_tuning_history",
        "provider_knowledge_exposure",
        "quality",
        "licence_constraints",
        "unknowns"
      ],
      "title": "ExposureAndQuality",
      "type": "object"
    },
    "PITGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "PITGrade",
      "type": "string"
    },
    "QualityLabels": {
      "additionalProperties": false,
      "properties": {
        "membership_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/PITGrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "membership_notes": {
          "minLength": 1,
          "title": "Membership Notes",
          "type": "string"
        },
        "membership_status": {
          "enum": [
            "point_in_time",
            "backfilled",
            "unknown",
            "not_applicable"
          ],
          "title": "Membership Status",
          "type": "string"
        },
        "timing_basis": {
          "minLength": 1,
          "title": "Timing Basis",
          "type": "string"
        },
        "timing_grade": {
          "$ref": "#/$defs/PITGrade"
        },
        "vintage_notes": {
          "minLength": 1,
          "title": "Vintage Notes",
          "type": "string"
        },
        "vintage_status": {
          "enum": [
            "verified",
            "unknown",
            "restated"
          ],
          "title": "Vintage Status",
          "type": "string"
        }
      },
      "required": [
        "timing_grade",
        "timing_basis",
        "vintage_status",
        "vintage_notes",
        "membership_grade",
        "membership_status",
        "membership_notes"
      ],
      "title": "QualityLabels",
      "type": "object"
    },
    "SnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "pattern": "^[A-Za-z0-9_=/.-]+$",
          "title": "Path",
          "type": "string"
        },
        "physical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Physical Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "physical_sha256",
        "bytes"
      ],
      "title": "SnapshotFile",
      "type": "object"
    },
    "SnapshotTable": {
      "additionalProperties": false,
      "properties": {
        "available_date_column": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Available Date Column"
        },
        "columns": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Columns",
          "type": "object"
        },
        "date_column": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Column"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/SnapshotFile"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "grain": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Grain",
          "type": "array"
        },
        "licence_note": {
          "minLength": 1,
          "title": "Licence Note",
          "type": "string"
        },
        "logical_hash_spec": {
          "const": "qfr-table/1:sorted-grain,sorted-columns,float-hex,null",
          "title": "Logical Hash Spec",
          "type": "string"
        },
        "logical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Sha256",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityLabels"
        },
        "research_visible": {
          "default": true,
          "title": "Research Visible",
          "type": "boolean"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "source_hashes": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Hashes",
          "type": "object"
        }
      },
      "required": [
        "name",
        "files",
        "columns",
        "grain",
        "date_column",
        "available_date_column",
        "rows",
        "logical_sha256",
        "logical_hash_spec",
        "quality",
        "licence_note",
        "source_hashes"
      ],
      "title": "SnapshotTable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archive_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Archive Sha256"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "build_code_version": {
      "minLength": 1,
      "title": "Build Code Version",
      "type": "string"
    },
    "conventions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Conventions",
      "type": "object"
    },
    "exposure": {
      "$ref": "#/$defs/ExposureAndQuality"
    },
    "profile": {
      "minLength": 1,
      "title": "Profile",
      "type": "string"
    },
    "release_tag": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Release Tag"
    },
    "research_cutoff": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Research Cutoff"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/SnapshotTable"
      },
      "minItems": 1,
      "title": "Tables",
      "type": "array"
    },
    "zone": {
      "enum": [
        "research",
        "full"
      ],
      "title": "Zone",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "profile",
    "zone",
    "research_cutoff",
    "as_of",
    "source",
    "release_tag",
    "archive_sha256",
    "build_code_version",
    "conventions",
    "tables",
    "exposure"
  ],
  "title": "SnapshotManifest",
  "type": "object"
}
