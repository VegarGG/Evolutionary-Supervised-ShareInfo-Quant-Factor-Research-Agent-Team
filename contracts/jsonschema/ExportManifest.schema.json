{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ExportEntry": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "artifact_manifest",
            "artifact_payload",
            "source_manifest",
            "dataset_manifest",
            "public_protocol_card",
            "released_report",
            "configuration_reference",
            "provenance",
            "delivery_receipt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "reference_id",
        "sha256",
        "bytes"
      ],
      "title": "ExportEntry",
      "type": "object"
    },
    "VersionReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "sha256"
      ],
      "title": "VersionReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "export_id": {
      "minLength": 1,
      "title": "Export Id",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ExportEntry"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "job_id": {
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/VersionReference"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Config Hash",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "export_id",
    "job_id",
    "receipt",
    "artifact_refs",
    "files",
    "created_at",
    "source_config_hash"
  ],
  "title": "ExportManifest",
  "type": "object"
}
