{
  "$defs": {
    "RequestedSettings": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Output Tokens"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "temperature": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking_budget_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Budget Tokens"
        },
        "top_p": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "title": "RequestedSettings",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "ambiguous_outcome": {
          "const": "persist_before_retry",
          "title": "Ambiguous Outcome",
          "type": "string"
        },
        "backoff": {
          "enum": [
            "exponential_with_jitter",
            "fixed",
            "none"
          ],
          "title": "Backoff",
          "type": "string"
        },
        "backoff_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backoff Seconds"
        },
        "max_attempts": {
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "max_attempts",
        "backoff",
        "ambiguous_outcome"
      ],
      "title": "RetryPolicy",
      "type": "object"
    },
    "Timeouts": {
      "additionalProperties": false,
      "properties": {
        "connect_seconds": {
          "exclusiveMinimum": 0,
          "title": "Connect Seconds",
          "type": "number"
        },
        "idle_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idle Seconds"
        },
        "read_seconds": {
          "exclusiveMinimum": 0,
          "title": "Read Seconds",
          "type": "number"
        }
      },
      "required": [
        "connect_seconds",
        "read_seconds"
      ],
      "title": "Timeouts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_policy_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Context Policy Ref"
    },
    "fallback_allowlist": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Fallback Allowlist",
      "type": "array"
    },
    "max_tool_turns": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tool Turns"
    },
    "model_profile": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Profile"
    },
    "override_source": {
      "minLength": 1,
      "title": "Override Source",
      "type": "string"
    },
    "per_call_timeouts": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timeouts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt_template_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Template Ref"
    },
    "requested_settings": {
      "anyOf": [
        {
          "$ref": "#/$defs/RequestedSettings"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retry_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetryPolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "role_profile": {
      "minLength": 1,
      "title": "Role Profile",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "role_profile",
    "override_source"
  ],
  "title": "TaskOverride",
  "type": "object"
}
