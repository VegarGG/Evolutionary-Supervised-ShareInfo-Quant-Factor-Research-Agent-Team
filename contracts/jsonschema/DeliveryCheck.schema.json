{
  "$defs": {
    "VersionReference": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "sha256"
      ],
      "title": "VersionReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "check_id": {
      "minLength": 1,
      "title": "Check Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/VersionReference"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_ref": {
      "minLength": 1,
      "title": "Schema Ref",
      "type": "string"
    }
  },
  "required": [
    "check_id",
    "schema_ref",
    "result",
    "evidence_refs"
  ],
  "title": "DeliveryCheck",
  "type": "object"
}
