{
  "$defs": {
    "PITGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "PITGrade",
      "type": "string"
    },
    "QualityLabels": {
      "additionalProperties": false,
      "properties": {
        "membership_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/PITGrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "membership_notes": {
          "minLength": 1,
          "title": "Membership Notes",
          "type": "string"
        },
        "membership_status": {
          "enum": [
            "point_in_time",
            "backfilled",
            "unknown",
            "not_applicable"
          ],
          "title": "Membership Status",
          "type": "string"
        },
        "timing_basis": {
          "minLength": 1,
          "title": "Timing Basis",
          "type": "string"
        },
        "timing_grade": {
          "$ref": "#/$defs/PITGrade"
        },
        "vintage_notes": {
          "minLength": 1,
          "title": "Vintage Notes",
          "type": "string"
        },
        "vintage_status": {
          "enum": [
            "verified",
            "unknown",
            "restated"
          ],
          "title": "Vintage Status",
          "type": "string"
        }
      },
      "required": [
        "timing_grade",
        "timing_basis",
        "vintage_status",
        "vintage_notes",
        "membership_grade",
        "membership_status",
        "membership_notes"
      ],
      "title": "QualityLabels",
      "type": "object"
    },
    "SnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "pattern": "^[A-Za-z0-9_=/.-]+$",
          "title": "Path",
          "type": "string"
        },
        "physical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Physical Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "physical_sha256",
        "bytes"
      ],
      "title": "SnapshotFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_date_column": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Available Date Column"
    },
    "columns": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Columns",
      "type": "object"
    },
    "date_column": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Date Column"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SnapshotFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "grain": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Grain",
      "type": "array"
    },
    "licence_note": {
      "minLength": 1,
      "title": "Licence Note",
      "type": "string"
    },
    "logical_hash_spec": {
      "const": "qfr-table/1:sorted-grain,sorted-columns,float-hex,null",
      "title": "Logical Hash Spec",
      "type": "string"
    },
    "logical_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Logical Sha256",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Name",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/QualityLabels"
    },
    "research_visible": {
      "default": true,
      "title": "Research Visible",
      "type": "boolean"
    },
    "rows": {
      "minimum": 0,
      "title": "Rows",
      "type": "integer"
    },
    "source_hashes": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Source Hashes",
      "type": "object"
    }
  },
  "required": [
    "name",
    "files",
    "columns",
    "grain",
    "date_column",
    "available_date_column",
    "rows",
    "logical_sha256",
    "logical_hash_spec",
    "quality",
    "licence_note",
    "source_hashes"
  ],
  "title": "SnapshotTable",
  "type": "object"
}
