{
  "$defs": {
    "ServiceTokenBinding": {
      "additionalProperties": false,
      "properties": {
        "principal": {
          "minLength": 1,
          "title": "Principal",
          "type": "string"
        },
        "programs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Programs",
          "type": "array"
        },
        "roles": {
          "items": {
            "enum": [
              "reader",
              "research_lead"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "token_ref": {
          "pattern": "^env:[A-Z][A-Z0-9_]*$",
          "title": "Token Ref",
          "type": "string"
        }
      },
      "required": [
        "principal",
        "token_ref",
        "roles",
        "programs"
      ],
      "title": "ServiceTokenBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audience": {
      "enum": [
        "feedback",
        "research",
        "mcp"
      ],
      "title": "Audience",
      "type": "string"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/ServiceTokenBinding"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "maximum_token_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 4096,
      "title": "Maximum Token Bytes",
      "type": "integer"
    },
    "minimum_token_bytes": {
      "exclusiveMinimum": 0,
      "minimum": 32,
      "title": "Minimum Token Bytes",
      "type": "integer"
    },
    "revision": {
      "exclusiveMinimum": 0,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "audience",
    "minimum_token_bytes",
    "maximum_token_bytes",
    "bindings"
  ],
  "title": "ServiceAuthentication",
  "type": "object"
}
