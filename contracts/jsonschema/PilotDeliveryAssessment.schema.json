{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_version_id": {
          "minLength": 1,
          "title": "Artifact Version Id",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "artifact_version_id",
        "content_hash"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exact artifact roles frozen before the human-driven pilot job is admitted.",
  "properties": {
    "assessed_artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "minItems": 1,
      "title": "Assessed Artifact Refs",
      "type": "array"
    },
    "reference_artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Reference Artifact Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "assessed_artifact_refs",
    "reference_artifact_refs"
  ],
  "title": "PilotDeliveryAssessment",
  "type": "object"
}
