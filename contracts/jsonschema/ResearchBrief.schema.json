{
  "$defs": {
    "BriefBudgets": {
      "additionalProperties": false,
      "properties": {
        "authorized_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authorized Cost Usd"
        },
        "authorized_spend_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authorized Spend Ref"
        },
        "concurrency_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Concurrency Limit"
        },
        "evaluator_quota_ref": {
          "minLength": 1,
          "title": "Evaluator Quota Ref",
          "type": "string"
        },
        "max_generations": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Generations"
        },
        "max_wall_clock_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Max Wall Clock Seconds"
        },
        "token_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token Limit"
        }
      },
      "required": [
        "authorized_spend_ref",
        "authorized_cost_usd",
        "token_limit",
        "concurrency_limit",
        "max_wall_clock_seconds",
        "max_generations",
        "evaluator_quota_ref"
      ],
      "title": "BriefBudgets",
      "type": "object"
    },
    "Conclusion": {
      "enum": [
        "supported_positive",
        "supported_negative",
        "empty_shortlist",
        "data_blocked"
      ],
      "title": "Conclusion",
      "type": "string"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "DecisionCycle": {
      "additionalProperties": false,
      "properties": {
        "execution_rule": {
          "minLength": 1,
          "title": "Execution Rule",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "publication_rule": {
          "minLength": 1,
          "title": "Publication Rule",
          "type": "string"
        },
        "review_rule": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Review Rule"
        },
        "signal_date_rule": {
          "minLength": 1,
          "title": "Signal Date Rule",
          "type": "string"
        }
      },
      "required": [
        "name",
        "signal_date_rule",
        "publication_rule",
        "execution_rule",
        "review_rule"
      ],
      "title": "DecisionCycle",
      "type": "object"
    },
    "DeliverableRequirement": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs_required": {
          "title": "Evidence Refs Required",
          "type": "boolean"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema_ref",
        "required",
        "evidence_refs_required"
      ],
      "title": "DeliverableRequirement",
      "type": "object"
    },
    "ExitGateSpecification": {
      "additionalProperties": false,
      "properties": {
        "allowed_conclusions": {
          "items": {
            "$ref": "#/$defs/Conclusion"
          },
          "minItems": 1,
          "title": "Allowed Conclusions",
          "type": "array"
        },
        "evidence_release_requirements": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Release Requirements",
          "type": "array"
        },
        "forward_evidence_required": {
          "title": "Forward Evidence Required",
          "type": "boolean"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "gate_id": {
          "minLength": 1,
          "title": "Gate Id",
          "type": "string"
        },
        "gate_type": {
          "enum": [
            "research_delivery",
            "investment_promotion"
          ],
          "title": "Gate Type",
          "type": "string"
        },
        "human_signoff_required": {
          "title": "Human Signoff Required",
          "type": "boolean"
        },
        "independent_checker_required": {
          "const": true,
          "title": "Independent Checker Required",
          "type": "boolean"
        },
        "protocol_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Protocol Refs",
          "type": "array"
        },
        "reproducibility_criteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reproducibility Criteria",
          "type": "array"
        },
        "required_checks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Checks",
          "type": "array"
        },
        "required_deliverables": {
          "items": {
            "$ref": "#/$defs/DeliverableRequirement"
          },
          "minItems": 1,
          "title": "Required Deliverables",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "spec_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Spec Hash",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "gate_id",
        "gate_type",
        "required_deliverables",
        "protocol_refs",
        "required_checks",
        "reproducibility_criteria",
        "evidence_release_requirements",
        "allowed_conclusions",
        "human_signoff_required",
        "forward_evidence_required",
        "independent_checker_required",
        "frozen_at",
        "spec_hash"
      ],
      "title": "ExitGateSpecification",
      "type": "object"
    },
    "ExposureAndQuality": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "enum": [
            "previously_seen",
            "unknown",
            "prospective"
          ],
          "title": "History",
          "type": "string"
        },
        "inspected_periods": {
          "items": {
            "$ref": "#/$defs/DateRange"
          },
          "title": "Inspected Periods",
          "type": "array"
        },
        "licence_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Licence Constraints",
          "type": "array"
        },
        "provider_knowledge_exposure": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Provider Knowledge Exposure",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityLabels"
        },
        "training_tuning_history": {
          "minLength": 1,
          "title": "Training Tuning History",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "history",
        "inspected_periods",
        "training_tuning_history",
        "provider_knowledge_exposure",
        "quality",
        "licence_constraints",
        "unknowns"
      ],
      "title": "ExposureAndQuality",
      "type": "object"
    },
    "PITGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "PITGrade",
      "type": "string"
    },
    "QualityLabels": {
      "additionalProperties": false,
      "properties": {
        "membership_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/PITGrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "membership_notes": {
          "minLength": 1,
          "title": "Membership Notes",
          "type": "string"
        },
        "membership_status": {
          "enum": [
            "point_in_time",
            "backfilled",
            "unknown",
            "not_applicable"
          ],
          "title": "Membership Status",
          "type": "string"
        },
        "timing_basis": {
          "minLength": 1,
          "title": "Timing Basis",
          "type": "string"
        },
        "timing_grade": {
          "$ref": "#/$defs/PITGrade"
        },
        "vintage_notes": {
          "minLength": 1,
          "title": "Vintage Notes",
          "type": "string"
        },
        "vintage_status": {
          "enum": [
            "verified",
            "unknown",
            "restated"
          ],
          "title": "Vintage Status",
          "type": "string"
        }
      },
      "required": [
        "timing_grade",
        "timing_basis",
        "vintage_status",
        "vintage_notes",
        "membership_grade",
        "membership_status",
        "membership_notes"
      ],
      "title": "QualityLabels",
      "type": "object"
    },
    "SelectionRule": {
      "additionalProperties": false,
      "properties": {
        "fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fraction"
        },
        "rounding": {
          "enum": [
            "ceil",
            "floor",
            "exact_count"
          ],
          "title": "Rounding",
          "type": "string"
        },
        "tie_break": {
          "minLength": 1,
          "title": "Tie Break",
          "type": "string"
        },
        "top_n": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top N"
        },
        "weighting": {
          "minLength": 1,
          "title": "Weighting",
          "type": "string"
        }
      },
      "required": [
        "rounding",
        "tie_break",
        "weighting"
      ],
      "title": "SelectionRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_artifact_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Baseline Artifact Ids",
      "type": "array"
    },
    "benchmarks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Benchmarks",
      "type": "array"
    },
    "brief_id": {
      "minLength": 1,
      "title": "Brief Id",
      "type": "string"
    },
    "budgets": {
      "$ref": "#/$defs/BriefBudgets"
    },
    "constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "cost_levels_bps": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "title": "Cost Levels Bps",
      "type": "array"
    },
    "decision_cycles": {
      "items": {
        "$ref": "#/$defs/DecisionCycle"
      },
      "title": "Decision Cycles",
      "type": "array"
    },
    "eligibility_rule_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Eligibility Rule Ref"
    },
    "exit_gate": {
      "$ref": "#/$defs/ExitGateSpecification"
    },
    "exposure": {
      "$ref": "#/$defs/ExposureAndQuality"
    },
    "frozen_config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Frozen Config Hash",
      "type": "string"
    },
    "human_checkpoints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Human Checkpoints",
      "type": "array"
    },
    "input_bundle_id": {
      "minLength": 1,
      "title": "Input Bundle Id",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "preservation_rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Preservation Rules",
      "type": "array"
    },
    "primary_benchmark": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Primary Benchmark"
    },
    "primary_metric": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Primary Metric"
    },
    "project_id": {
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "protocol_proposal_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Protocol Proposal Ref"
    },
    "role_profiles": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Role Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary_metrics": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Secondary Metrics",
      "type": "array"
    },
    "selection_rule": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionRule"
        },
        {
          "type": "null"
        }
      ]
    },
    "success_criteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Success Criteria",
      "type": "array"
    },
    "universe_codes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Universe Codes",
      "type": "array"
    },
    "universe_label_map_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Universe Label Map Ref"
    }
  },
  "required": [
    "schema_version",
    "brief_id",
    "project_id",
    "input_bundle_id",
    "objective",
    "universe_codes",
    "universe_label_map_ref",
    "benchmarks",
    "primary_benchmark",
    "decision_cycles",
    "selection_rule",
    "eligibility_rule_ref",
    "primary_metric",
    "secondary_metrics",
    "cost_levels_bps",
    "protocol_proposal_ref",
    "exposure",
    "baseline_artifact_ids",
    "preservation_rules",
    "constraints",
    "success_criteria",
    "budgets",
    "exit_gate",
    "role_profiles",
    "human_checkpoints",
    "frozen_config_hash"
  ],
  "title": "ResearchBrief",
  "type": "object"
}
