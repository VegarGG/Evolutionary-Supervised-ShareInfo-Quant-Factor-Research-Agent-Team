{
  "$defs": {
    "DatasetTable": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Columns",
          "type": "array"
        },
        "date_column": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Date Column"
        },
        "date_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/DateRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "grain": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Grain",
          "type": "array"
        },
        "licence_note": {
          "minLength": 1,
          "title": "Licence Note",
          "type": "string"
        },
        "logical_hash_spec": {
          "minLength": 1,
          "title": "Logical Hash Spec",
          "type": "string"
        },
        "logical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Logical Sha256",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "physical_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Physical Sha256",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityLabels"
        },
        "rows": {
          "minimum": 0,
          "title": "Rows",
          "type": "integer"
        },
        "schema_ref": {
          "minLength": 1,
          "title": "Schema Ref",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "source_description": {
          "minLength": 1,
          "title": "Source Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path",
        "physical_sha256",
        "logical_sha256",
        "logical_hash_spec",
        "rows",
        "columns",
        "date_range",
        "date_column",
        "grain",
        "schema_ref",
        "quality",
        "licence_note",
        "source_description",
        "source_asset_ids"
      ],
      "title": "DatasetTable",
      "type": "object"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "ExposureAndQuality": {
      "additionalProperties": false,
      "properties": {
        "history": {
          "enum": [
            "previously_seen",
            "unknown",
            "prospective"
          ],
          "title": "History",
          "type": "string"
        },
        "inspected_periods": {
          "items": {
            "$ref": "#/$defs/DateRange"
          },
          "title": "Inspected Periods",
          "type": "array"
        },
        "licence_constraints": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Licence Constraints",
          "type": "array"
        },
        "provider_knowledge_exposure": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Provider Knowledge Exposure",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityLabels"
        },
        "training_tuning_history": {
          "minLength": 1,
          "title": "Training Tuning History",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "history",
        "inspected_periods",
        "training_tuning_history",
        "provider_knowledge_exposure",
        "quality",
        "licence_constraints",
        "unknowns"
      ],
      "title": "ExposureAndQuality",
      "type": "object"
    },
    "PITGrade": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "title": "PITGrade",
      "type": "string"
    },
    "QualityLabels": {
      "additionalProperties": false,
      "properties": {
        "membership_grade": {
          "anyOf": [
            {
              "$ref": "#/$defs/PITGrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "membership_notes": {
          "minLength": 1,
          "title": "Membership Notes",
          "type": "string"
        },
        "membership_status": {
          "enum": [
            "point_in_time",
            "backfilled",
            "unknown",
            "not_applicable"
          ],
          "title": "Membership Status",
          "type": "string"
        },
        "timing_basis": {
          "minLength": 1,
          "title": "Timing Basis",
          "type": "string"
        },
        "timing_grade": {
          "$ref": "#/$defs/PITGrade"
        },
        "vintage_notes": {
          "minLength": 1,
          "title": "Vintage Notes",
          "type": "string"
        },
        "vintage_status": {
          "enum": [
            "verified",
            "unknown",
            "restated"
          ],
          "title": "Vintage Status",
          "type": "string"
        }
      },
      "required": [
        "timing_grade",
        "timing_basis",
        "vintage_status",
        "vintage_notes",
        "membership_grade",
        "membership_status",
        "membership_notes"
      ],
      "title": "QualityLabels",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "change_log": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Change Log",
      "type": "array"
    },
    "creator": {
      "minLength": 1,
      "title": "Creator",
      "type": "string"
    },
    "dataset_version_id": {
      "minLength": 1,
      "title": "Dataset Version Id",
      "type": "string"
    },
    "exposure": {
      "$ref": "#/$defs/ExposureAndQuality"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "parent_dataset_version_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Dataset Version Id"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/DatasetTable"
      },
      "minItems": 1,
      "title": "Tables",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "dataset_version_id",
    "manifest_sha256",
    "as_of",
    "creator",
    "parent_dataset_version_id",
    "change_log",
    "tables",
    "exposure"
  ],
  "title": "DatasetManifest",
  "type": "object"
}
