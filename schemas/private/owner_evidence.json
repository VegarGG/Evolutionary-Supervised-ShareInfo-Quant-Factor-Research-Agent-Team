{
  "$defs": {
    "EvaluationState": {
      "additionalProperties": false,
      "description": "Where the version is in the evaluator's lifecycle (Section 7.9).",
      "properties": {
        "decided_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Decided At"
        },
        "discovered_at": {
          "format": "date-time",
          "title": "Discovered At",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Duplicate Of"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason Code"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "reason_code",
        "duplicate_of",
        "discovered_at",
        "decided_at"
      ],
      "title": "EvaluationState",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "skipped_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Skipped Reason"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threshold"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "passed",
        "value",
        "threshold",
        "skipped_reason"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "JsonValue": {},
    "OfficialRecord": {
      "additionalProperties": false,
      "properties": {
        "container_image_digest": {
          "title": "Container Image Digest",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Snapshot Id",
          "type": "string"
        },
        "epoch_id": {
          "title": "Epoch Id",
          "type": "string"
        },
        "evaluator_code_version": {
          "title": "Evaluator Code Version",
          "type": "string"
        },
        "family_id": {
          "format": "uuid7",
          "title": "Family Id",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Job Id"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metrics",
          "type": "object"
        },
        "principal": {
          "title": "Principal",
          "type": "string"
        },
        "program_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Program Id"
        },
        "protocol_id": {
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "record_id": {
          "format": "uuid7",
          "title": "Record Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "results_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Results Hash",
          "type": "string"
        },
        "run_ids": {
          "items": {
            "format": "uuid7",
            "type": "string"
          },
          "minItems": 1,
          "title": "Run Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "official_record/1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "screening",
            "w1",
            "w2",
            "holdout",
            "simulation"
          ],
          "title": "Stage",
          "type": "string"
        },
        "summary": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Summary",
          "type": "object"
        },
        "version_id": {
          "format": "uuid7",
          "title": "Version Id",
          "type": "string"
        },
        "window": {
          "enum": [
            "W1",
            "W2",
            "W3",
            "W4"
          ],
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash",
        "protocol_id",
        "protocol_version",
        "data_snapshot_id",
        "evaluator_code_version",
        "schema_version",
        "record_id",
        "epoch_id",
        "family_id",
        "program_id",
        "job_id",
        "stage",
        "window",
        "run_ids",
        "container_image_digest",
        "seed",
        "summary",
        "metrics",
        "results_hash",
        "created_at",
        "principal",
        "request_id"
      ],
      "title": "OfficialRecord",
      "type": "object"
    },
    "SeriesReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "nav",
            "rankic",
            "ls_returns"
          ],
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "format": "uuid7",
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "window": {
          "enum": [
            "W1",
            "W2",
            "W3",
            "W4"
          ],
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "window",
        "kind",
        "uri",
        "sha256"
      ],
      "title": "SeriesReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluation": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationState"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_values": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gate Values",
      "type": "array"
    },
    "hygiene_warning": {
      "const": "Never copy owner-only evidence into research briefs or steering notes.",
      "title": "Hygiene Warning",
      "type": "string"
    },
    "library_correlation": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Library Correlation"
    },
    "official_records": {
      "items": {
        "$ref": "#/$defs/OfficialRecord"
      },
      "title": "Official Records",
      "type": "array"
    },
    "reference_strategy_stats": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Reference Strategy Stats",
      "type": "object"
    },
    "schema_version": {
      "const": "owner_evidence/1",
      "title": "Schema Version",
      "type": "string"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/SeriesReference"
      },
      "title": "Series",
      "type": "array"
    },
    "simulation_state": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Simulation State"
    },
    "version_id": {
      "format": "uuid7",
      "title": "Version Id",
      "type": "string"
    },
    "visibility": {
      "const": "owner_only",
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "visibility",
    "version_id",
    "evaluation",
    "official_records",
    "gate_values",
    "series",
    "reference_strategy_stats",
    "library_correlation",
    "simulation_state",
    "hygiene_warning"
  ],
  "title": "OwnerEvidence",
  "type": "object"
}
