        },
        "size_neutral_rankic": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Size Neutral Rankic"
        },
        "strategy_drawdown_bucket": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
