    "W1Content": {
      "additionalProperties": false,
      "properties": {
        "complexity": {
          "minimum": 0,
          "title": "Complexity",
          "type": "integer"
        },
        "coverage_bucket": {
          "enum": [
            "FAIL",
            "PASS"
          ],
          "title": "Coverage Bucket",
          "type": "string"
        },
        "decay_profile": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "1",
              "5",
              "10",
              "20"
            ]
          },
          "title": "Decay Profile",
          "type": "object"
        },
        "flags": {
          "items": {
            "$ref": "#/$defs/DiagnosticFlag"
          },
          "title": "Flags",
          "type": "array"
        },
        "hit_ratio": {
          "maximum": 1,
          "minimum": 0,
