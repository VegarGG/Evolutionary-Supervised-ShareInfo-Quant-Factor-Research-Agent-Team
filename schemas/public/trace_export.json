        "strategy_net_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strategy Net Sharpe"
        },
        "top_turnover": {
          "maximum": 1,
          "minimum": 0,
          "title": "Top Turnover",
          "type": "number"
        },
        "type": {
          "const": "w1",
          "title": "Type",
          "type": "string"
        },
        "yearly_rankic": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Yearly Rankic",
          "type": "object"
        }
      },
      "required": [
        "type",
        "rankic_mean",
        "rankic_ir",
        "nw_t_bucket",
        "hit_ratio",
        "decay_profile",
        "ls_net_sharpe",
        "monotonicity",
        "top_turnover",
        "rank_autocorrelation",
        "max_library_correlation",
        "library_version_id",
        "library_empty",
        "yearly_rankic",
        "coverage_bucket",
        "size_neutral_rankic",
        "complexity",
        "flags"
      ],
