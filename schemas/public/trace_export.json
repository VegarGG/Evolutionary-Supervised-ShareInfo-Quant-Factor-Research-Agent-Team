        },
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "parent_version_id": {
          "format": "uuid7",
          "title": "Parent Version Id",
          "type": "string"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "child_version_id",
        "parent_version_id",
        "relation",
        "operator",
