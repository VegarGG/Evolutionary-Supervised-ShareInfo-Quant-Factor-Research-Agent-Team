{
  "$defs": {
    "AdvancementContent": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ADVANCED",
            "NOT_ADVANCED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "advancement",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "AdvancementContent",
      "type": "object"
    },
    "DecisionContent": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "anyOf": [
            {
              "enum": [
                "G-W1",
                "G-W2",
                "G-HOLDOUT",
                "G-DSR",
                "G-PBO",
                "G-HLZ",
                "G-FWD",
                "G-NOVELTY",
                "G-OPS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gate"
        },
        "reason": {
          "enum": [
            "gate_failed",
            "owner_rejected",
            "incubation_failed",
            "gates_passed"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "decision",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status",
        "reason"
      ],
      "title": "DecisionContent",
      "type": "object"
    },
    "DiagnosticFlag": {
      "enum": [
        "HIGH_TURNOVER",
        "LOW_MONOTONICITY",
        "SIGN_MISMATCH",
        "CROWDED_WITH_LIBRARY",
        "UNSTABLE_YEARLY",
        "DECAYS_FAST",
        "LOW_COVERAGE",
        "WEAK_SIGNAL",
        "COST_DOMINATED",
        "HIGH_DRAWDOWN"
      ],
      "title": "DiagnosticFlag",
      "type": "string"
    },
    "IntakeContent": {
      "additionalProperties": false,
      "properties": {
        "duplicate_of": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "DUPLICATE",
            "DEFERRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "enum": [
            "intake",
            "screening"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status",
        "reasons"
      ],
      "title": "IntakeContent",
      "type": "object"
    },
    "JsonValue": {},
    "LibraryContent": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "seed",
            "active",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "library",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "LibraryContent",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "SCHEMA_INVALID",
        "KIND_UNSUPPORTED",
        "PARSE_ERROR",
        "TYPE_ERROR",
        "COMPLEXITY_LIMIT",
        "FORBIDDEN_CONSTRUCT",
        "DECLARATION_MISMATCH",
        "COMPONENT_INVALID",
        "DUPLICATE_OF",
        "NEAR_DUPLICATE_OF",
        "QUOTA_DEFERRED",
        "QUOTA_EXPIRED",
        "LOW_COVERAGE",
        "LOOKAHEAD_DETECTED",
        "RUNTIME_LIMIT",
        "DEGENERATE",
        "INTERNAL_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ReleasedReport": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "discriminator": {
            "mapping": {
              "advancement": "#/$defs/AdvancementContent",
              "decision": "#/$defs/DecisionContent",
              "intake": "#/$defs/IntakeContent",
              "library": "#/$defs/LibraryContent",
              "screening": "#/$defs/IntakeContent",
              "sim": "#/$defs/SimulationContent",
              "w1": "#/$defs/W1Content",
              "w2": "#/$defs/W2Content"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/IntakeContent"
            },
            {
              "$ref": "#/$defs/W1Content"
            },
            {
              "$ref": "#/$defs/W2Content"
            },
            {
              "$ref": "#/$defs/AdvancementContent"
            },
            {
              "$ref": "#/$defs/SimulationContent"
            },
            {
              "$ref": "#/$defs/DecisionContent"
            },
            {
              "$ref": "#/$defs/LibraryContent"
            }
          ],
          "title": "Content"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Snapshot Id",
          "type": "string"
        },
        "evaluator_code_version": {
          "title": "Evaluator Code Version",
          "type": "string"
        },
        "family_id": {
          "format": "uuid7",
          "title": "Family Id",
          "type": "string"
        },
        "policy_ref": {
          "title": "Policy Ref",
          "type": "string"
        },
        "program_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Program Id"
        },
        "protocol_card_ref": {
          "title": "Protocol Card Ref",
          "type": "string"
        },
        "protocol_id": {
          "title": "Protocol Id",
          "type": "string"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "released_at": {
          "format": "date-time",
          "title": "Released At",
          "type": "string"
        },
        "report_id": {
          "format": "uuid7",
          "title": "Report Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "version_id": {
          "format": "uuid7",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "content_hash",
        "protocol_id",
        "protocol_version",
        "data_snapshot_id",
        "evaluator_code_version",
        "schema_version",
        "report_id",
        "family_id",
        "program_id",
        "policy_ref",
        "protocol_card_ref",
        "released_at",
        "content"
      ],
      "title": "ReleasedReport",
      "type": "object"
    },
    "SimulationContent": {
      "additionalProperties": false,
      "properties": {
        "forward_rankic_bucket": {
          "enum": [
            "negative",
            "0_to_0.01",
            "0.01_to_0.03",
            "above_0.03"
          ],
          "title": "Forward Rankic Bucket",
          "type": "string"
        },
        "forward_sharpe_bucket": {
          "title": "Forward Sharpe Bucket",
          "type": "number"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "sim",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status",
        "forward_rankic_bucket",
        "forward_sharpe_bucket"
      ],
      "title": "SimulationContent",
      "type": "object"
    },
    "TraceAgentRun": {
      "additionalProperties": false,
      "description": "One agent_runs row inlined in a trace export (Section 14.3).",
      "properties": {
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "number"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "prompt_template_id": {
          "title": "Prompt Template Id",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "enum": [
                "deepseek",
                "kimi",
                "glm"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "request_messages": {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Request Messages",
          "type": "array"
        },
        "response_json": {
          "$ref": "#/$defs/JsonValue"
        },
        "response_text": {
          "title": "Response Text",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "format": "uuid7",
          "title": "Run Id",
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Settings",
          "type": "object"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "fallback"
          ],
          "title": "Status",
          "type": "string"
        },
        "step_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step Id"
        },
        "usage": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "role",
        "provider",
        "model_id",
        "prompt_template_id",
        "prompt_sha256",
        "request_messages",
        "response_text",
        "response_json",
        "usage",
        "settings",
        "status",
        "latency_ms"
      ],
      "title": "TraceAgentRun",
      "type": "object"
    },
    "TraceLineageEdge": {
      "additionalProperties": false,
      "properties": {
        "ast_diff": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
