{
  "$defs": {
    "BundleFile": {
      "additionalProperties": false,
      "description": "One file of an export bundle, with the schema it validates against (none for\nMarkdown, CSV and Parquet; owner_records holds owner_evidence/1 documents).",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
          "title": "Path",
          "type": "string"
        },
        "schema_name": {
          "anyOf": [
            {
              "enum": [
                "deliverable",
                "factor_manifest",
                "strategy_manifest",
                "trace_export",
                "owner_records"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Schema Name"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "schema_name"
      ],
      "title": "BundleFile",
      "type": "object"
    },
    "BundleItem": {
      "additionalProperties": false,
      "properties": {
        "directory": {
          "title": "Directory",
          "type": "string"
        },
        "kind": {
          "enum": [
            "factor",
            "strategy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "trace_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Trace Hash",
          "type": "string"
        },
        "trace_hash_matches_deliverable": {
          "title": "Trace Hash Matches Deliverable",
          "type": "boolean"
        },
        "version_id": {
          "format": "uuid7",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "kind",
        "directory",
        "trace_hash",
        "trace_hash_matches_deliverable"
      ],
      "title": "BundleItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "export_bundle/1: the index of a deliverable bundle under exports/<job>/<deliverable>/\n(Section 13.4). MANIFEST.sha256 lists every file including this one.",
  "properties": {
    "deliverable_id": {
      "format": "uuid7",
      "title": "Deliverable Id",
      "type": "string"
    },
    "evidence": {
      "enum": [
        "ok",
        "evaluator_not_configured",
        "evaluator_unavailable"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "exported_at": {
      "format": "date-time",
      "title": "Exported At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BundleFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "hygiene_warning": {
      "const": "Never copy owner-only evidence into research briefs or steering notes.",
      "title": "Hygiene Warning",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/BundleItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "job_id": {
      "format": "uuid7",
      "title": "Job Id",
      "type": "string"
    },
    "schema_version": {
      "const": "export_bundle/1",
      "title": "Schema Version",
      "type": "string"
    },
    "short_codes": {
      "items": {
        "type": "string"
      },
      "title": "Short Codes",
      "type": "array"
    },
    "visibility": {
      "const": "owner_only",
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "deliverable_id",
    "job_id",
    "exported_at",
    "visibility",
    "hygiene_warning",
    "evidence",
    "short_codes",
    "items",
    "files"
  ],
  "title": "ExportBundle",
  "type": "object"
}
