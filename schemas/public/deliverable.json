{
  "$defs": {
    "AdvancementContent": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ADVANCED",
            "NOT_ADVANCED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "advancement",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "AdvancementContent",
      "type": "object"
    },
    "AgentRunRef": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "prompt_template_id": {
          "title": "Prompt Template Id",
          "type": "string"
        },
        "provider": {
          "enum": [
            "deepseek",
            "kimi",
            "glm"
          ],
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "run_id": {
          "format": "uuid7",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "role",
        "provider",
        "model_id",
        "prompt_template_id",
        "prompt_sha256",
        "run_id"
      ],
      "title": "AgentRunRef",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "sign": {
          "enum": [
            -1,
            1
          ],
          "title": "Sign",
          "type": "integer"
        },
        "version_id": {
          "format": "uuid7",
          "title": "Version Id",
          "type": "string"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "multipleOf": 0.01,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "version_id",
        "sign",
        "weight"
      ],
      "title": "Component",
      "type": "object"
    },
    "DecisionContent": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "anyOf": [
            {
              "enum": [
                "G-W1",
                "G-W2",
                "G-HOLDOUT",
                "G-DSR",
                "G-PBO",
                "G-HLZ",
                "G-FWD",
                "G-NOVELTY",
                "G-OPS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gate"
        },
        "reason": {
          "enum": [
            "gate_failed",
            "owner_rejected",
            "incubation_failed",
            "gates_passed"
          ],
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "enum": [
            "ACCEPTED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "decision",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status",
        "reason"
      ],
      "title": "DecisionContent",
      "type": "object"
    },
    "DeliverableItem": {
      "additionalProperties": false,
      "properties": {
        "caveats": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Caveats",
          "type": "array"
        },
        "iteration_history": {
          "$ref": "#/$defs/IterationHistory"
        },
        "kind": {
          "enum": [
            "factor",
            "strategy"
          ],
          "title": "Kind",
          "type": "string"
        },
        "manifest": {
          "discriminator": {
            "mapping": {
              "factor": "#/$defs/FactorManifest",
              "strategy": "#/$defs/StrategyManifest"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FactorManifest"
            },
            {
              "$ref": "#/$defs/StrategyManifest"
            }
          ],
          "title": "Manifest"
        },
        "owner_evidence": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Evidence"
        },
        "released_reports": {
          "items": {
            "$ref": "#/$defs/ReleasedReport"
          },
          "title": "Released Reports",
          "type": "array"
        },
        "tier_reached": {
          "anyOf": [
            {
              "enum": [
                "w1_pass",
                "w2_pass",
                "advanced",
                "incubated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tier Reached"
        },
        "trace_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Trace Hash",
          "type": "string"
        },
        "trace_ref": {
          "format": "uuid7",
          "title": "Trace Ref",
          "type": "string"
        },
        "version_id": {
          "format": "uuid7",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "version_id",
        "kind",
        "manifest",
        "tier_reached",
        "iteration_history",
        "trace_ref",
        "trace_hash",
        "released_reports",
        "owner_evidence",
        "caveats"
      ],
      "title": "DeliverableItem",
      "type": "object"
    },
    "DiagnosticFlag": {
      "enum": [
        "HIGH_TURNOVER",
        "LOW_MONOTONICITY",
        "SIGN_MISMATCH",
        "CROWDED_WITH_LIBRARY",
        "UNSTABLE_YEARLY",
        "DECAYS_FAST",
        "LOW_COVERAGE",
        "WEAK_SIGNAL",
        "COST_DOMINATED",
        "HIGH_DRAWDOWN"
      ],
      "title": "DiagnosticFlag",
      "type": "string"
    },
    "FactorDeclaration": {
      "additionalProperties": false,
      "properties": {
        "expected_sign": {
          "enum": [
            -1,
            1
          ],
          "title": "Expected Sign",
          "type": "integer"
        },
        "fields_used": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fields Used",
          "type": "array"
        },
        "horizon_days": {
          "enum": [
            1,
            5,
            10,
            20
          ],
          "title": "Horizon Days",
          "type": "integer"
        },
        "max_lookback_days": {
          "minimum": 0,
          "title": "Max Lookback Days",
          "type": "integer"
        }
      },
      "required": [
        "expected_sign",
        "horizon_days",
        "fields_used",
        "max_lookback_days"
      ],
      "title": "FactorDeclaration",
      "type": "object"
    },
    "FactorImplementation": {
      "additionalProperties": false,
      "properties": {
        "expression": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "language": {
          "const": "qfr-dsl/1",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "language",
        "expression"
      ],
      "title": "FactorImplementation",
      "type": "object"
    },
    "FactorManifest": {
      "additionalProperties": false,
      "properties": {
        "declared": {
          "$ref": "#/$defs/FactorDeclaration"
        },
        "family_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Family Id"
        },
        "implementation": {
          "$ref": "#/$defs/FactorImplementation"
        },
        "kind": {
          "const": "factor",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rationale": {
          "$ref": "#/$defs/Rationale"
        },
        "review": {
          "$ref": "#/$defs/Review"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "self_assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "family_id",
        "name",
        "title",
        "implementation",
        "declared",
        "rationale",
        "provenance",
        "review"
      ],
      "title": "FactorManifest",
      "type": "object"
    },
    "HistoryHop": {
      "additionalProperties": false,
      "properties": {
        "ast_diff": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Ast Diff",
          "type": "array"
        },
        "candidate_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Id"
        },
        "change_summary": {
          "title": "Change Summary",
          "type": "string"
        },
        "critic": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Critic"
        },
        "engineer": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRunRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluation": {
          "items": {
            "$ref": "#/$defs/ReleasedReport"
          },
          "title": "Evaluation",
          "type": "array"
        },
        "expression_after": {
          "title": "Expression After",
          "type": "string"
        },
        "expression_before": {
          "items": {
            "type": "string"
          },
          "title": "Expression Before",
          "type": "array"
        },
        "from_version_ids": {
          "items": {
            "format": "uuid7",
            "type": "string"
          },
          "title": "From Version Ids",
          "type": "array"
        },
        "generation_seq": {
          "minimum": 0,
          "title": "Generation Seq",
          "type": "integer"
        },
        "hypothesis_title": {
          "title": "Hypothesis Title",
          "type": "string"
        },
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "owner_grade": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner Grade"
        },
        "targeted_flags": {
          "items": {
            "$ref": "#/$defs/DiagnosticFlag"
          },
          "title": "Targeted Flags",
          "type": "array"
        },
        "to_version_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Version Id"
        },
        "workbench": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchAssessment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from_version_ids",
        "to_version_id",
        "candidate_id",
        "generation_seq",
        "operator",
        "targeted_flags",
        "hypothesis_title",
        "change_summary",
        "expression_before",
        "expression_after",
        "ast_diff",
        "engineer",
        "critic",
        "workbench",
        "evaluation",
        "owner_grade",
        "outcome"
      ],
      "title": "HistoryHop",
      "type": "object"
    },
    "IntakeContent": {
      "additionalProperties": false,
      "properties": {
        "duplicate_of": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/ReasonCode"
          },
          "title": "Reasons",
          "type": "array"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "DUPLICATE",
            "DEFERRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "enum": [
            "intake",
            "screening"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status",
        "reasons"
      ],
      "title": "IntakeContent",
      "type": "object"
    },
    "IterationHistory": {
      "additionalProperties": false,
      "properties": {
        "discarded": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Discarded",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "hops": {
          "items": {
            "$ref": "#/$defs/HistoryHop"
          },
          "title": "Hops",
          "type": "array"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Job Id"
        },
        "roots": {
          "items": {
            "format": "uuid7",
            "type": "string"
          },
          "title": "Roots",
          "type": "array"
        },
        "schema_version": {
          "const": "iteration_history/1",
          "title": "Schema Version",
          "type": "string"
        },
        "totals": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Totals",
          "type": "object"
        },
        "trace_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Trace Hash",
          "type": "string"
        },
        "version_id": {
          "format": "uuid7",
          "title": "Version Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "version_id",
        "job_id",
        "generated_at",
        "trace_hash",
        "roots",
        "hops",
        "discarded",
        "totals"
      ],
      "title": "IterationHistory",
      "type": "object"
    },
    "JsonValue": {},
    "LibraryContent": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "seed",
            "active",
            "retired"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "library",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status"
      ],
      "title": "LibraryContent",
      "type": "object"
    },
    "Portfolio": {
      "additionalProperties": false,
      "properties": {
        "dropout": {
          "maximum": 20,
          "minimum": 1,
          "title": "Dropout",
          "type": "integer"
        },
        "long_only": {
          "const": true,
          "title": "Long Only",
          "type": "boolean"
        },
        "rebalance": {
          "const": "daily",
          "title": "Rebalance",
          "type": "string"
        },
        "top_k": {
          "maximum": 100,
          "minimum": 20,
          "title": "Top K",
          "type": "integer"
        },
        "type": {
          "const": "topk_dropout",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "top_k",
        "dropout",
        "rebalance",
        "long_only"
      ],
      "title": "Portfolio",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "agent_runs": {
          "items": {
            "$ref": "#/$defs/AgentRunRef"
          },
          "title": "Agent Runs",
          "type": "array"
        },
        "generation_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation Id"
        },
        "island_id": {
          "anyOf": [
            {
              "enum": [
                "I1",
                "I2",
                "I3",
                "I4",
                "I5",
                "I6"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Island Id"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Job Id"
        },
        "operator": {
          "enum": [
            "explore",
            "llm_mutation",
            "syntactic_mutation",
            "crossover",
            "repair",
            "human_seed"
          ],
          "title": "Operator",
          "type": "string"
        },
        "parent_version_ids": {
          "items": {
            "format": "uuid7",
            "type": "string"
          },
          "title": "Parent Version Ids",
          "type": "array"
        },
        "program_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Program Id"
        },
        "qfr_core_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Qfr Core Version",
          "type": "string"
        },
        "research_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Research Snapshot Id"
        },
        "trace_ref": {
          "format": "uuid7",
          "title": "Trace Ref",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "program_id",
        "generation_id",
        "island_id",
        "operator",
        "parent_version_ids",
        "agent_runs",
        "trace_ref",
        "research_snapshot_id",
        "qfr_core_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Rationale": {
      "additionalProperties": false,
      "properties": {
        "change_summary": {
          "anyOf": [
            {
              "maxLength": 600,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Summary"
        },
        "falsification": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Falsification",
          "type": "string"
        },
        "hypothesis_id": {
          "format": "uuid7",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "mechanism": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
        },
        "summary": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "summary",
        "mechanism",
        "falsification"
      ],
      "title": "Rationale",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "SCHEMA_INVALID",
        "KIND_UNSUPPORTED",
        "PARSE_ERROR",
        "TYPE_ERROR",
        "COMPLEXITY_LIMIT",
        "FORBIDDEN_CONSTRUCT",
        "DECLARATION_MISMATCH",
        "COMPONENT_INVALID",
        "DUPLICATE_OF",
        "NEAR_DUPLICATE_OF",
        "QUOTA_DEFERRED",
        "QUOTA_EXPIRED",
        "LOW_COVERAGE",
        "LOOKAHEAD_DETECTED",
        "RUNTIME_LIMIT",
        "DEGENERATE",
        "INTERNAL_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ReleasedReport": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "discriminator": {
            "mapping": {
              "advancement": "#/$defs/AdvancementContent",
              "decision": "#/$defs/DecisionContent",
              "intake": "#/$defs/IntakeContent",
              "library": "#/$defs/LibraryContent",
              "screening": "#/$defs/IntakeContent",
              "sim": "#/$defs/SimulationContent",
              "w1": "#/$defs/W1Content",
              "w2": "#/$defs/W2Content"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/IntakeContent"
            },
            {
              "$ref": "#/$defs/W1Content"
            },
            {
              "$ref": "#/$defs/W2Content"
            },
            {
              "$ref": "#/$defs/AdvancementContent"
            },
            {
              "$ref": "#/$defs/SimulationContent"
            },
            {
              "$ref": "#/$defs/DecisionContent"
            },
            {
              "$ref": "#/$defs/LibraryContent"
            }
          ],
          "title": "Content"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Snapshot Id",
          "type": "string"
        },
        "evaluator_code_version": {
          "title": "Evaluator Code Version",
          "type": "string"
        },
        "family_id": {
          "format": "uuid7",
          "title": "Family Id",
          "type": "string"
        },
        "policy_ref": {
          "title": "Policy Ref",
          "type": "string"
        },
        "program_id": {
          "anyOf": [
            {
              "format": "uuid7",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
